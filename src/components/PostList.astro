---
import type { Post } from '../lib/content';
import { postSlug, slugify } from '../lib/content';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  posts: Post[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
const tr = useTranslations(lang);
const more = lang === 'pl' ? 'Czytaj' : 'Read';
---

<ul class="posts">
  {
    posts.map((p, i) => {
      const href = `${routes.blog[lang]}${postSlug(p)}/`;
      return (
        <li class="rv" style={`--d:${(Math.min(i, 5) * 0.08).toFixed(2)}s`}>
          <article class="pcard">
            {p.data.cover && (
              <a class="cover" href={href} tabindex="-1" aria-hidden="true">
                <img src={p.data.cover} alt="" loading="lazy" decoding="async" />
              </a>
            )}
            <div class="body">
              <div class="meta">
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date, lang)}</time>
                {p.data.sample && <span class="smp">{tr('sample.badge')}</span>}
              </div>
              <h3>
                <a href={href}>{p.data.title}</a>
              </h3>
              <p>{p.data.description}</p>
              <div class="foot">
                {p.data.tags.length > 0 && (
                  <ul class="tags">
                    {p.data.tags.map((t) => (
                      <li>
                        <a href={`${routes.blog[lang]}tag/${slugify(t)}/`}>{t}</a>
                      </li>
                    ))}
                  </ul>
                )}
                <a class="go" href={href} aria-label={`${more}: ${p.data.title}`}>
                  {more} <span class="arr">→</span>
                </a>
              </div>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  .pcard {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(160deg, var(--bg3), var(--bg2));
    transition:
      border-color 0.5s,
      box-shadow 0.7s,
      transform 0.6s var(--ease);
  }
  .pcard::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 120%;
    aspect-ratio: 1;
    right: -60%;
    bottom: -80%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 165, 71, 0.14), transparent 60%);
    opacity: 0;
    transition: opacity 0.8s;
    pointer-events: none;
  }
  .pcard:hover {
    border-color: rgba(232, 165, 71, 0.45);
    box-shadow: 0 30px 80px -30px rgba(232, 165, 71, 0.25);
    transform: translateY(-4px);
  }
  .pcard:hover::before {
    opacity: 1;
  }
  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) brightness(0.8);
    transition: transform 1.2s var(--ease);
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, var(--bg3));
  }
  .pcard:hover .cover img {
    transform: scale(1.05);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.4vw, 30px);
  }
  .meta {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  time {
    font-family: var(--serif);
    font-style: italic;
    color: var(--fern);
    font-size: 15px;
  }
  .smp {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    border: 1px solid var(--line2);
    padding: 2px 7px;
  }
  h3 {
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: 300;
    line-height: 1.1;
  }
  h3 a {
    text-decoration: none;
    transition: color 0.3s;
  }
  h3 a:hover {
    color: var(--amber2);
  }
  p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
    flex: 1;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    margin-top: 6px;
  }
  .tags {
    gap: 12px;
    font-size: 11px;
  }
  .go {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber2);
    text-decoration: none;
    margin-left: auto;
  }
  .go .arr {
    display: inline-block;
    transition: transform 0.35s;
  }
  .go:hover .arr {
    transform: translateX(4px);
  }
</style>
