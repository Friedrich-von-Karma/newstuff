---
import { site } from '../data/site';
import { routes, useTranslations, type Lang } from '../i18n/ui';
import ContactLinks from './ContactLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap grid">
    <div>
      <p class="name">Blattodea<span>.pl</span></p>
      <p class="muted small">{tr('site.tagline')}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href={routes.pricelist[lang]}>{tr('nav.pricelist')}</a></li>
        <li><a href={routes.species[lang]}>{tr('nav.species')}</a></li>
        <li><a href={routes.key[lang]}>{tr('nav.key')}</a></li>
        <li><a href={routes.blog[lang]}>{tr('nav.blog')}</a></li>
        <li><a href={routes.contact[lang]}>{tr('nav.contact')}</a></li>
      </ul>
    </nav>
    <div>
      <ContactLinks lang={lang} compact />
    </div>
  </div>
  <div class="wrap legal">
    <p class="muted small">© {year} {site.name}. {tr('footer.rights')}</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: 2rem;
    border-top: 1px solid var(--rule-strong);
    box-shadow: inset 0 3px 0 -2px var(--rule);
    background: var(--paper-2);
    padding: 2.5rem 0 1rem;
  }
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
  .name {
    font-family: var(--serif-display);
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--moss-dark);
    margin: 0 0 0.3rem;
  }
  .name span {
    color: var(--rust);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .small {
    font-size: 0.85rem;
  }
  .legal {
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
</style>
