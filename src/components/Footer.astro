---
import { site } from '../data/site';
import { routes, useTranslations, type Lang } from '../i18n/ui';
import ContactLinks from './ContactLinks.astro';
import ExLibris from './ExLibris.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap grid">
    <div class="colophon">
      <ExLibris dark />
      <p class="small">blattodea.pl · {tr('site.tagline')}</p>
    </div>
    <nav aria-label="Footer">
      <p class="h caps">{lang === 'pl' ? 'Spis działów' : 'Contents'}</p>
      <ul>
        <li><a href={routes.pricelist[lang]}>{tr('nav.pricelist')}</a></li>
        <li><a href={routes.species[lang]}>{tr('nav.species')}</a></li>
        <li><a href={routes.key[lang]}>{tr('nav.key')}</a></li>
        <li><a href={routes.blog[lang]}>{tr('nav.blog')}</a></li>
        <li><a href={routes.contact[lang]}>{tr('nav.contact')}</a></li>
      </ul>
    </nav>
    <div>
      <p class="h caps">{tr('nav.contact')}</p>
      <ContactLinks lang={lang} compact dark />
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.name}. {tr('footer.rights')}</p>
    <p>{lang === 'pl' ? 'Zdjęcia gatunków: Wikimedia Commons – autorzy i licencje podane pod każdym zdjęciem.' : 'Species photos: Wikimedia Commons – author and licence shown under each photo.'}</p>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: 3rem;
    color: var(--paper-2);
    background-color: var(--wood-800);
    background-image: var(--grain), var(--woodgrain), linear-gradient(180deg, var(--wood-700), var(--wood-900));
    border-top: 6px solid var(--wood-900);
    box-shadow: inset 0 1px 0 var(--brass-dark), inset 0 8px 18px -10px rgba(0, 0, 0, 0.8);
    padding: 3.5rem 0 1.5rem;
    overflow: hidden;
  }
  .grid {
    display: grid;
    gap: 2.2rem;
  }
  @media (min-width: 800px) {
    .grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  .colophon :global(.exlibris) {
    margin: 6px 0 1.2rem 6px;
  }
  .small {
    font-size: 0.88rem;
    color: var(--paper-3);
    opacity: 0.8;
  }
  .h {
    font-size: 1.1rem;
    color: var(--brass-light);
    margin: 0 0 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(220, 192, 138, 0.25);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  nav a {
    color: var(--paper-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--brass-light);
  }
  .legal {
    margin-top: 2.5rem;
    border-top: 1px solid rgba(220, 192, 138, 0.2);
    padding-top: 1.2rem;
    font-size: 0.8rem;
    color: var(--paper-3);
    opacity: 0.75;
  }
  .legal p {
    margin: 0 0 0.3rem;
  }
</style>
