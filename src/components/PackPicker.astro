---
/**
 * Cena paczki 10 szt. i przycisk „Napisz w sprawie zamówienia” (mail z gotowym tematem i treścią).
 * To nie jest sklep – zamówienia ustalane są mailowo. Gdy gatunku brak lub jest „wkrótce” – „Powiadom mnie”.
 */
import type { CollectionEntry } from 'astro:content';
import { buttonVariants } from '@/components/ui/button';
import { site } from '../data/site';
import { pick, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { formatEur, formatPrice } from '../lib/content';

interface Props {
  item: CollectionEntry<'pricelist'>;
  lang: Lang;
  /** większa cena (np. na dużym kaflu) */
  big?: boolean;
}
const { item, lang, big = false } = Astro.props;
const tr = useTranslations(lang);
const d = item.data;
const stage = tr(`pack.${d.stage}` as UiKey);
const orderable = d.status === 'available' || d.status === 'low';
const t = pick(lang, {
  pl: {
    choose: 'W paczce',
    ask: 'Napisz w sprawie zamówienia',
    notify: 'Powiadom mnie',
    waitHint: d.status === 'soon' ? 'Gatunek pojawi się wkrótce – napisz, a dam znać.' : 'Chwilowo brak – napisz, a dam znać, gdy będzie dostępny.',
    subject: `Zamówienie: ${d.latin} (${stage}, paczka 10 szt.)`,
    body: `Dzień dobry,
interesuje mnie ${d.latin} – ${stage}, paczka 10 szt.

Liczba paczek: 
Miejscowość (do wyceny wysyłki): 

Pozdrawiam`,
    waitSubject: `Lista oczekujących: ${d.latin}`,
    waitBody: `Dzień dobry,
proszę o wiadomość, gdy ${d.latin} (${stage}) będzie dostępny.

Pozdrawiam`,
    per: '/ 10 szt.',
  },
  en: {
    choose: 'In the pack',
    ask: 'E-mail about an order',
    notify: 'Notify me',
    waitHint: d.status === 'soon' ? 'Coming soon – write to me and I will let you know.' : 'Out of stock for now – write to me and I will let you know when it is available.',
    subject: `Order: ${d.latin} (${stage}, pack of 10)`,
    body: `Hello,
I am interested in ${d.latin} – ${stage}, pack of 10.

Number of packs: 
Country / town (for a shipping quote): 

Best regards`,
    waitSubject: `Waiting list: ${d.latin}`,
    waitBody: `Hello,
please let me know when ${d.latin} (${stage}) is available.

Best regards`,
    per: '/ 10 pcs',
  },
  de: {
    choose: 'In der Packung',
    ask: 'Per E-Mail anfragen',
    notify: 'Benachrichtigen',
    waitHint: d.status === 'soon' ? 'Demnächst verfügbar – schreib mir, dann melde ich mich.' : 'Derzeit nicht verfügbar – schreib mir, dann melde ich mich, sobald die Art verfügbar ist.',
    subject: `Bestellung: ${d.latin} (${stage}, 10er-Packung)`,
    body: `Hallo,
ich interessiere mich für ${d.latin} – ${stage}, 10er-Packung.

Anzahl der Packungen: 
Land / Ort (für die Versandkosten): 

Viele Grüße`,
    waitSubject: `Warteliste: ${d.latin}`,
    waitBody: `Hallo,
bitte gib mir Bescheid, wenn ${d.latin} (${stage}) verfügbar ist.

Viele Grüße`,
    per: '/ 10 Stk.',
  },
});
const mail = (subject: string, body: string) => `mailto:${site.contact.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<div class:list={['picker', { big }]}>
  <p class="variants">
    <span class="legend">{t.choose}</span>
    <span class="stage">{stage}</span>
  </p>
  <div class="buy">
    <div class="price">
      <span>{formatPrice(d.price, lang)}</span>
      {lang !== 'pl' && <small class="eur">{formatEur(d.price, lang)}</small>}
      <small>{t.per}</small>
    </div>
    <div class="acts">
      {
        orderable ? (
          <a class={buttonVariants()} href={mail(t.subject, t.body)}>
            {t.ask} <span class="arr">→</span>
          </a>
        ) : (
          <a class={buttonVariants({ variant: 'outline' })} href={mail(t.waitSubject, t.waitBody)}>
            <span class="bell" aria-hidden="true">◔</span> {t.notify}
          </a>
        )
      }
    </div>
  </div>
  {!orderable && <p class="wait">{t.waitHint}</p>}
</div>

<style>
  .picker {
    display: grid;
    gap: 14px;
    position: relative;
  }
  .variants {
    display: block;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .variants .legend {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    float: left;
    margin: 0 10px 0 0;
    padding: 0;
    line-height: 22px;
  }
  .stage {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 22px;
    color: var(--fern);
  }
  .buy {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 3vw, 44px);
    line-height: 0.9;
    color: var(--amber2);
    white-space: nowrap;
  }
  .big .price {
    font-size: clamp(38px, 3.6vw, 56px);
  }
  .price small {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin-left: 6px;
  }
  @keyframes flip {
    from {
      opacity: 0;
      transform: translateY(40%);
      filter: blur(6px);
    }
  }
  .acts {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  @keyframes pulse {
    40% {
      transform: scale(1.06);
      box-shadow: 0 0 40px rgba(232, 165, 71, 0.6);
    }
  }
  .bell {
    color: var(--amber);
  }
  .wait {
    margin: 0;
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
