---
/**
 * Paczka 10 szt. (jeden wariant na gatunek: nimfy, mix albo imago), cena, „Do koszyka” i „Zamów od razu”.
 * Gdy gatunku brak lub jest „wkrótce” – zamiast zamawiania przycisk „Powiadom mnie” (zapis na listę oczekujących).
 */
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';
import { useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { formatEur, formatPrice } from '../lib/content';

interface Props {
  item: CollectionEntry<'pricelist'>;
  lang: Lang;
  /** domyślnie zaznaczony wariant */
  initial?: 'nymph' | 'mix' | 'adult';
  /** większa cena (np. na dużym kaflu) */
  big?: boolean;
}
const { item, lang, initial, big = false } = Astro.props;
const tr = useTranslations(lang);
const pl = lang === 'pl';
const d = item.data;
const options = [{ kind: d.stage, price: d.price }];
const orderable = d.status === 'available' || d.status === 'low';
const first = options.find((o) => o.kind === initial) ?? options[0];
const group = `pack-${item.id}-${Math.random().toString(36).slice(2, 6)}`;
const label = (k: string) => tr(`pack.${k}` as UiKey);
const subjectFor = (k: string) => `${tr('pack.order')}: ${d.latin} – ${tr('pack.pcs')}, ${label(k)}`;
const t = pl
  ? {
      choose: 'W paczce',
      add: 'Do koszyka',
      added: 'Dodano',
      now: 'Zamów od razu',
      notify: 'Powiadom mnie',
      waitHint: d.status === 'soon' ? 'Gatunek pojawi się wkrótce – zapisz się na listę oczekujących.' : 'Chwilowo brak – zapisz się, a dam znać, gdy będzie dostępny.',
      waitSubject: `Lista oczekujących: ${d.latin}`,
      waitBody: `Dzień dobry,\nproszę o wiadomość, gdy ${d.latin} będzie dostępny.\nInteresujący mnie wariant: {v} (paczka 10 szt.).\n\nPozdrawiam`,
      per: '/ 10 szt.',
    }
  : {
      choose: 'In the pack',
      add: 'Add to cart',
      added: 'Added',
      now: 'Order now',
      notify: 'Notify me',
      waitHint: d.status === 'soon' ? 'Coming soon – join the waiting list.' : 'Out of stock for now – join the list and I will let you know.',
      waitSubject: `Waiting list: ${d.latin}`,
      waitBody: `Hello,\nplease let me know when ${d.latin} is available.\nOption I am interested in: {v} (pack of 10).\n\nBest regards`,
      per: '/ 10 pcs',
    };
const waitHref = (k: string) =>
  `mailto:${site.contact.email}?subject=${encodeURIComponent(t.waitSubject)}&body=${encodeURIComponent(t.waitBody.replace('{v}', label(k)))}`;
---

<div
  class:list={['picker', { big }]}
  data-picker
  data-id={item.id}
  data-latin={d.latin}
  data-email={site.contact.email}
  data-wait-subject={t.waitSubject}
  data-wait-body={t.waitBody}
>
  <fieldset class="variants">
    <legend>{t.choose}</legend>
    {
      options.map((o) => (
        <label class="var">
          <input
            type="radio"
            name={group}
            value={o.kind}
            checked={o.kind === first?.kind}
            data-price={o.price}
            data-price-label={formatPrice(o.price, lang)}
            data-label={label(o.kind)}
            data-subject={subjectFor(o.kind)}
          />
          <span>{label(o.kind)}</span>
        </label>
      ))
    }
  </fieldset>

  <div class="buy">
    <div class="price" aria-live="polite">
      <span data-price-out>{first ? formatPrice(first.price, lang) : '—'}</span>
      {lang !== 'pl' && first && <small class="eur">{formatEur(first.price, lang)}</small>}
      <small>{t.per}</small>
    </div>
    {
      orderable && first ? (
        <div class="acts">
          <button type="button" class="btn add" data-add>
            <span data-add-label>{t.add}</span> <span class="arr">+</span>
          </button>
          <a class="btn ghost small now" data-now href={`mailto:${site.contact.email}?subject=${encodeURIComponent(subjectFor(first.kind))}`}>
            {t.now}
          </a>
        </div>
      ) : (
        first && (
          <div class="acts">
            <a class="btn ghost notify" data-notify href={waitHref(first.kind)}>
              <span class="bell" aria-hidden="true">
                ◔
              </span>{' '}
              {t.notify}
            </a>
          </div>
        )
      )
    }
  </div>
  {!orderable && <p class="wait">{t.waitHint}</p>}
  <span class="added-msg" data-added-msg data-text={t.added} aria-live="polite"></span>
</div>

<script>
  import { cart, openCart } from '../scripts/cart';

  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((p) => {
    if (p.dataset.ready) return;
    p.dataset.ready = '1';
    const out = p.querySelector<HTMLElement>('[data-price-out]');
    const now = p.querySelector<HTMLAnchorElement>('[data-now]');
    const notify = p.querySelector<HTMLAnchorElement>('[data-notify]');
    const email = p.dataset.email ?? '';
    const sel = () => p.querySelector<HTMLInputElement>('input[type=radio]:checked');

    p.addEventListener('change', () => {
      const r = sel();
      if (!r) return;
      if (out) {
        out.classList.remove('flip');
        void out.offsetWidth;
        out.textContent = r.dataset.priceLabel ?? '';
        out.classList.add('flip');
      }
      if (now) now.href = `mailto:${email}?subject=${encodeURIComponent(r.dataset.subject ?? '')}`;
      if (notify)
        notify.href = `mailto:${email}?subject=${encodeURIComponent(p.dataset.waitSubject ?? '')}&body=${encodeURIComponent(
          (p.dataset.waitBody ?? '').replace('{v}', r.dataset.label ?? ''),
        )}`;
    });

    p.querySelector<HTMLButtonElement>('[data-add]')?.addEventListener('click', (e) => {
      const r = sel();
      if (!r) return;
      cart.add({
        id: p.dataset.id ?? '',
        latin: p.dataset.latin ?? '',
        kind: r.value as 'nymph' | 'mix' | 'adult',
        kindLabel: r.dataset.label ?? r.value,
        price: Number(r.dataset.price),
      });
      const btn = e.currentTarget as HTMLButtonElement;
      btn.classList.remove('pulse');
      void btn.offsetWidth;
      btn.classList.add('pulse');
      openCart();
    });
  });
</script>

<style>
  .picker {
    display: grid;
    gap: 14px;
    position: relative;
  }
  .variants {
    display: block;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .variants legend {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
    float: left;
    margin: 0 10px 0 0;
    padding: 0;
    line-height: 22px;
  }
  .var {
    position: relative;
  }
  .var input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .var span {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 22px;
    color: var(--fern);
  }
  .buy {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .price {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(32px, 3vw, 44px);
    line-height: 0.9;
    color: var(--amber2);
    white-space: nowrap;
  }
  .big .price {
    font-size: clamp(38px, 3.6vw, 56px);
  }
  .price small {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.06em;
    margin-left: 6px;
  }
  .price :global(.flip) {
    display: inline-block;
    animation: flip 0.45s var(--ease);
  }
  @keyframes flip {
    from {
      opacity: 0;
      transform: translateY(40%);
      filter: blur(6px);
    }
  }
  .acts {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .add.pulse {
    animation: pulse 0.6s var(--ease);
  }
  @keyframes pulse {
    40% {
      transform: scale(1.06);
      box-shadow: 0 0 40px rgba(232, 165, 71, 0.6);
    }
  }
  .bell {
    color: var(--amber);
  }
  .wait {
    margin: 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  .added-msg {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
