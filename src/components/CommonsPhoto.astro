---
import { tl, pick } from '../i18n/ui';
/** Zdjęcie gatunku z Wikimedia Commons z podpisem: autor, licencja, źródło. */
import { photos, photoSrc, photoPage } from '../data/photos';
import type { Lang } from '../i18n/ui';

interface Props {
  id: string;
  lang: Lang;
  alt: string;
  width?: 330 | 500 | 960 | 1280;
  class?: string;
  /** krótki podpis zamiast pełnego (np. na kafelkach) */
  compact?: boolean;
  eager?: boolean;
}
const { id, lang, alt, width = 960, class: cls, compact = false, eager = false } = Astro.props;
const p = photos[id];
const pl = lang === 'pl';
---

{
  p ? (
    <figure class:list={['cphoto', cls]}>
      <span class="frame">
        <img src={photoSrc(p, width)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" />
      </span>
      <figcaption class="credit">
        {!compact && p.subject && <span class="subj">{tl(p.subject, lang)}. </span>}
        {pick(lang, { pl: 'Fot.', en: 'Photo:', de: 'Foto:' })} {p.author} ·{' '}
        <a href={p.licenseUrl} target="_blank" rel="noopener license">
          {p.license}
        </a>{' '}
        ·{' '}
        <a href={photoPage(p)} target="_blank" rel="noopener">
          Wikimedia Commons
        </a>
      </figcaption>
    </figure>
  ) : (
    <figure class:list={['cphoto', 'missing', cls]}>
      <span class="frame">
        <span class="nophoto">
          <b>{pick(lang, { pl: 'brak zdjęcia', en: 'no photo', de: 'noch kein Foto' })}</b>
          {pick(lang, { pl: 'na wolnej licencji', en: 'under a free licence yet', de: 'unter freier Lizenz' })}
        </span>
      </span>
    </figure>
  )
}

<style>
  .cphoto {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .frame {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(60% 50% at 65% 45%, #2b2114 0%, transparent 70%),
      linear-gradient(160deg, #16231a, #0b120d);
    border-radius: 3px;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.88);
    transition:
      transform 1.2s var(--ease),
      filter 0.8s;
  }
  .cphoto:hover img {
    filter: saturate(1) brightness(0.95);
  }
  .credit {
    padding-top: 6px;
  }
</style>
