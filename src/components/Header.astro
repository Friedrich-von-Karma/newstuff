---
import ExLibris from './ExLibris.astro';
import { routes, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  alt: string;
  active?: RouteKey;
}
const { lang, alt, active } = Astro.props;
const tr = useTranslations(lang);

const nav: { key: RouteKey; label: string; n: string }[] = [
  { key: 'pricelist', label: tr('nav.pricelist'), n: 'I' },
  { key: 'species', label: tr('nav.species'), n: 'II' },
  { key: 'key', label: tr('nav.keyShort'), n: 'III' },
  { key: 'blog', label: tr('nav.blog'), n: 'IV' },
  { key: 'contact', label: tr('nav.contact'), n: 'V' },
];
---

<header class="masthead">
  <div class="topline">
    <div class="wrap topline-in">
      <span>Coll. Blattodea · Polonia</span>
      <span class="hide-sm">{tr('site.tagline')}</span>
      <a class="lang" href={alt} hreflang={lang === 'pl' ? 'en' : 'pl'} lang={lang === 'pl' ? 'en' : 'pl'}>
        <span class:list={{ on: lang === 'pl' }}>PL</span> / <span class:list={{ on: lang === 'en' }}>EN</span>
        <span class="visually-hidden"> – {tr('lang.switch')}</span>
      </a>
    </div>
  </div>
  <div class="wrap bar">
    <a class="brand" href={routes.home[lang]} aria-label="Blattodea.pl – start">
      <ExLibris dark compact />
    </a>

    <div class="menu">
      <button class="toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="burger" aria-hidden="true"></span>
        <span>{tr('nav.menu')}</span>
      </button>
      <nav id="site-nav" aria-label={tr('nav.menu')}>
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={routes[n.key][lang]} aria-current={active === n.key ? 'page' : undefined}>
                  <span class="n">{n.n}</span>
                  <span class="t">{n.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.masthead .toggle');
  const menu = document.querySelector<HTMLElement>('.masthead .menu');
  const header = document.querySelector<HTMLElement>('.masthead');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      menu.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
  // po przewinięciu nagłówek się zwęża
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    color: var(--label);
    background-color: var(--bottle-800);
    background-image: var(--grain), linear-gradient(180deg, var(--bottle-700), var(--bottle-900));
    border-bottom: 1px solid var(--brass-dark);
    box-shadow:
      0 1px 0 var(--bottle-900),
      0 3px 0 -1px var(--brass-dark),
      0 10px 24px -14px rgba(0, 0, 0, 0.7);
  }
  .topline {
    border-bottom: 1px solid rgba(220, 192, 138, 0.18);
    font-family: var(--f-type);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--sage);
    max-height: 40px;
    overflow: hidden;
    transition:
      max-height 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .scrolled .topline {
    max-height: 0;
    opacity: 0;
  }
  .topline-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
  }
  .lang {
    color: var(--sage);
    text-decoration: none;
    border: 1px solid rgba(220, 192, 138, 0.35);
    padding: 0.05rem 0.6rem;
  }
  .lang .on {
    color: var(--brass-light);
  }
  .lang:hover {
    color: var(--label);
    border-color: var(--brass);
  }
  @media (max-width: 640px) {
    .hide-sm {
      display: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 78px;
    position: relative;
    transition: min-height 0.35s var(--ease);
  }
  .scrolled .bar {
    min-height: 62px;
  }
  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: 6px 4px;
    transition: transform 0.4s var(--ease);
  }
  .brand:hover {
    transform: rotate(-1.5deg) scale(1.03);
  }
  .brand :global(.exlibris) {
    transition: font-size 0.35s var(--ease);
  }
  .scrolled .brand :global(.exlibris) {
    font-size: 9.5px;
  }
  @media (max-width: 420px) {
    .brand :global(.exlibris) {
      font-size: 9.5px;
    }
  }

  .toggle {
    font: inherit;
    font-family: var(--f-caps);
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: transparent;
    color: var(--label);
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--brass-dark);
    cursor: pointer;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    position: relative;
    transition:
      transform 0.3s var(--ease),
      background 0.3s;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
  }
  .burger::before {
    top: -6px;
  }
  .burger::after {
    top: 6px;
  }
  .open .burger {
    background: transparent;
  }
  .open .burger::before {
    transform: translateY(6px) rotate(45deg);
  }
  .open .burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--label);
    font-family: var(--f-display);
    font-size: 1.22rem;
    font-weight: 600;
  }
  .n {
    font-family: var(--f-caps);
    font-size: 0.78rem;
    color: var(--brass);
    letter-spacing: 0.06em;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--brass-light), transparent);
    transform: scaleX(0);
    transition: transform 0.4s var(--ease);
  }
  nav a:hover {
    color: var(--brass-light);
  }
  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  nav a[aria-current='page'] {
    color: var(--brass-light);
  }

  @media (max-width: 899px) {
    .menu nav {
      position: absolute;
      left: 16px;
      right: 16px;
      top: calc(100% + 8px);
      background: var(--bottle-800);
      background-image: var(--grain);
      border: 1px solid var(--brass-dark);
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.8);
      padding: 0.4rem 1.2rem;
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      pointer-events: none;
      transition:
        clip-path 0.45s var(--ease),
        opacity 0.3s;
    }
    .menu.open nav {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      pointer-events: auto;
    }
    nav li + li {
      border-top: 1px dashed rgba(220, 192, 138, 0.25);
    }
    nav a {
      padding: 0.75rem 0;
    }
    nav a::after {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .toggle {
      display: none;
    }
    nav ul {
      display: flex;
      gap: 1.9rem;
    }
  }
</style>
