---
import 'leaflet/dist/leaflet.css';
import Base from '../layouts/Base.astro';
import SubmitForm from '../components/SubmitForm.astro';
import { taxa } from '../data/key';
import { getObservations } from '../lib/content';
import { routes, formatDate, type Lang, tl, pick } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';

const t = pick(lang, {
  pl: {
      title: 'Mapa obserwacji',
      desc: 'Zweryfikowane obserwacje karaczanów w Polsce – rodzimych gatunków leśnych i tych, które żyją przy człowieku. Zgłoś własne znalezisko ze zdjęciem.',
      num: 'Mapa · obserwacje',
      h1a: 'Karaczany',
      h1b: 'na mapie Polski',
      lead: 'Punkty to zgłoszenia ze zdjęciami, które zostały sprawdzone i oznaczone. Każde nowe znalezisko – nawet pospolitego karaczana leśnego – pomaga ustalić, gdzie naprawdę występują poszczególne gatunki.',
      filter: 'Gatunek',
      all: 'Wszystkie gatunki',
      shown: 'widocznych punktów',
      of: 'z',
      emptyH: 'Pierwsze zweryfikowane zgłoszenia pojawią się tutaj',
      emptyP: 'Mapa dopiero czeka na punkty. Znalazłeś karaczana w lesie, na łące albo w budynku? Wyślij zdjęcie – po weryfikacji trafi tutaj.',
      emptyBtn: 'Zgłoś obserwację',
      wheel: 'Kliknij mapę, by przybliżać kółkiem myszy',
      observer: 'obserwator',
      profile: 'profil hodowlany →',
      howNum: 'Jak to działa',
      howH1: 'Od zdjęcia',
      howH2: 'do punktu na mapie',
      steps: [
        ['Zgłaszasz', 'Wysyłasz zdjęcia, miejsce i datę przez formularz poniżej albo mailem.'],
        ['Weryfikacja', 'Zdjęcia są oglądane i porównywane z cechami gatunków; czasem potrzebne jest dodatkowe pytanie.'],
        ['Punkt na mapie', 'Potwierdzona obserwacja – za Twoją zgodą – pojawia się na mapie z dokładnością do okolicy.'],
        ['Lepszy klucz', 'Zebrane dane pomagają poprawiać klucz: rozmieszczenie, siedliska i cechy gatunków w Polsce.'],
      ],
      formNum: 'Zgłoszenie',
      formH1: 'Zgłoś',
      formH2: 'obserwację',
      formP: 'Najważniejsze są ostre zdjęcia i miejsce. Jeśli nie wiesz, co to za gatunek – wybierz „nie wiem” albo najpierw sprawdź w kluczu.',
      keyLink: 'Klucz do oznaczania',
      unknown: 'gatunek nieoznaczony',
      year: 'Rok',
      allYears: 'Wszystkie lata',
      statsNum: 'Dane',
      statsH: 'Zgłoszenia',
      statsHem: 'w liczbach',
      byMonth: 'Zgłoszenia w poszczególnych miesiącach',
      latest: 'Najnowsze zgłoszenia',
      noLatest: 'Brak zgłoszeń do pokazania.',
      csv: 'Pobierz dane (CSV)',
      csvHint: 'Dane zgodne z filtrami powyżej – do wykorzystania w pracach naukowych z podaniem źródła: Blattodea.pl.',
      months: ['sty', 'lut', 'mar', 'kwi', 'maj', 'cze', 'lip', 'sie', 'wrz', 'paź', 'lis', 'gru'],
  },
  en: {
      title: 'Observation map',
      desc: 'Verified records of cockroaches in Poland – native woodland species and those living alongside people. Report your own find with a photo.',
      num: 'Map · records',
      h1a: 'Cockroaches',
      h1b: 'on the map of Poland',
      lead: 'Each point is a photo-backed record that has been checked and identified. Every new find – even a common wood cockroach in a forest – helps establish where each species really occurs.',
      filter: 'Species',
      all: 'All species',
      shown: 'points shown',
      of: 'of',
      emptyH: 'The first verified records will appear here',
      emptyP: 'The map is still waiting for its first points. Found a cockroach in a forest, a meadow or a building? Send a photo – once verified, it will show up here.',
      emptyBtn: 'Report a sighting',
      wheel: 'Click the map to zoom with the mouse wheel',
      observer: 'observer',
      profile: 'care sheet →',
      howNum: 'How it works',
      howH1: 'From a photo',
      howH2: 'to a point on the map',
      steps: [
        ['You report', 'Send photos, the place and date using the form below or by e-mail.'],
        ['Verification', 'The photos are examined and compared with species features; sometimes a follow-up question is needed.'],
        ['A point on the map', 'A confirmed record – with your consent – appears on the map, accurate to the general area.'],
        ['A better key', 'The data helps improve the key: distribution, habitats and features of species in Poland.'],
      ],
      formNum: 'Report',
      formH1: 'Report a',
      formH2: 'sighting',
      formP: 'Sharp photos and the location matter most. If you don’t know the species, choose “I don’t know” – or check the key first.',
      keyLink: 'Identification key',
      unknown: 'unidentified species',
      year: 'Year',
      allYears: 'All years',
      statsNum: 'Data',
      statsH: 'Records',
      statsHem: 'in numbers',
      byMonth: 'Records by month',
      latest: 'Latest records',
      noLatest: 'No records to show yet.',
      csv: 'Download data (CSV)',
      csvHint: 'Data matching the filters above – free to use in research, citing the source: Blattodea.pl.',
      months: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  },
  de: {
      title: 'Beobachtungskarte',
      desc: 'Geprüfte Schabenfunde in Polen – heimische Waldarten und solche, die beim Menschen leben. Melde deinen eigenen Fund mit Foto.',
      num: 'Karte · Funde',
      h1a: 'Schaben',
      h1b: 'auf der Karte Polens',
      lead: 'Jeder Punkt ist ein mit Fotos belegter Fund, der geprüft und bestimmt wurde. Jeder neue Fund – selbst eine häufige Waldschabe – hilft festzustellen, wo die einzelnen Arten wirklich vorkommen.',
      filter: 'Art',
      all: 'Alle Arten',
      shown: 'Punkte angezeigt',
      of: 'von',
      emptyH: 'Die ersten geprüften Funde erscheinen hier',
      emptyP: 'Die Karte wartet noch auf ihre ersten Punkte. Eine Schabe im Wald, auf einer Wiese oder in einem Gebäude gefunden? Schick ein Foto – nach der Prüfung erscheint sie hier.',
      emptyBtn: 'Fund melden',
      wheel: 'Klicke in die Karte, um mit dem Mausrad zu zoomen',
      observer: 'Beobachter',
      profile: 'Haltungsprofil →',
      howNum: 'So funktioniert es',
      howH1: 'Vom Foto',
      howH2: 'zum Punkt auf der Karte',
      steps: [
        ['Du meldest', 'Schick Fotos, Ort und Datum über das Formular unten oder per E-Mail.'],
        ['Prüfung', 'Die Fotos werden angesehen und mit den Artmerkmalen verglichen; manchmal ist eine Rückfrage nötig.'],
        ['Ein Punkt auf der Karte', 'Ein bestätigter Fund erscheint – mit deiner Zustimmung – auf der Karte, auf die ungefähre Gegend genau.'],
        ['Ein besserer Schlüssel', 'Die Daten helfen, den Schlüssel zu verbessern: Verbreitung, Lebensräume und Merkmale der Arten in Polen.'],
      ],
      formNum: 'Meldung',
      formH1: 'Fund',
      formH2: 'melden',
      formP: 'Am wichtigsten sind scharfe Fotos und der Fundort. Wenn du die Art nicht kennst, wähle „weiß nicht“ – oder prüfe sie zuerst mit dem Schlüssel.',
      keyLink: 'Bestimmungsschlüssel',
      unknown: 'unbestimmte Art',
      year: 'Jahr',
      allYears: 'Alle Jahre',
      statsNum: 'Daten',
      statsH: 'Funde',
      statsHem: 'in Zahlen',
      byMonth: 'Funde nach Monat',
      latest: 'Neueste Funde',
      noLatest: 'Noch keine Funde.',
      csv: 'Daten herunterladen (CSV)',
      csvHint: 'Daten gemäß den Filtern oben – frei für die Forschung nutzbar unter Angabe der Quelle: Blattodea.pl.',
      months: ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'],
  },
});

const obs = await getObservations();
const byId = new Map(taxa.map((x) => [x.id, x]));
const points = obs.map((o) => {
  const tx = byId.get(o.data.species);
  return {
    species: o.data.species,
    latin: tx?.latin ?? o.data.species,
    name: tl(tx?.name, lang) || '',
    profile: tx?.profile ? `${routes.species[lang]}${tx.profile}/` : '',
    lat: o.data.lat,
    lng: o.data.lng,
    place: o.data.place,
    date: formatDate(o.data.date, lang),
    iso: o.data.date.toISOString().slice(0, 10),
    url: tx ? `${routes.wild[lang]}${tx.id}/` : '',
    observer: o.data.observer ?? '',
    note: o.data.note ?? '',
    photo: o.data.photo ?? '',
  };
});
const counts = new Map<string, number>();
for (const p of points) counts.set(p.species, (counts.get(p.species) ?? 0) + 1);
const filterOptions = [...taxa].sort((a, b) => a.latin.localeCompare(b.latin));
const extraIds = [...counts.keys()].filter((k) => !byId.has(k));
const years = [...new Set(points.map((p) => p.iso.slice(0, 4)))].sort().reverse();
const mapData = { points, i18n: { observer: t.observer, profile: t.profile, none: t.noLatest } };
---

<Base lang={lang} title={t.title} description={t.desc} alt={routes.map[other]} active="map">
  <section class="page mappage">
    <div class="glowspot" style="width:640px;height:640px;right:-220px;top:20px;background:radial-gradient(circle,rgba(232,165,71,.12),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.num}</div>
          <h1 class="h-display">{t.h1a} <em>{t.h1b}</em></h1>
        </div>
        <p class="rv" style="--d:.15s" data-glossary>{t.lead}</p>
      </div>

      <div class="mapbar rv">
        <label class="mfilter">
          <span class="lbl">{t.filter}</span>
          <select id="map-filter" disabled={points.length === 0}>
            <option value="">{t.all} ({points.length})</option>
            {
              filterOptions.map((x) => (
                <option value={x.id} disabled={!counts.get(x.id)}>
                  {x.latin}
                  {tl(x.name, lang) ? ` – ${tl(x.name, lang)}` : ''} ({counts.get(x.id) ?? 0})
                </option>
              ))
            }
            {extraIds.map((id) => <option value={id}>{id} ({counts.get(id)})</option>)}
          </select>
        </label>
        <label class="mfilter yr">
          <span class="lbl">{t.year}</span>
          <select id="map-year" disabled={years.length === 0}>
            <option value="">{t.allYears}</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
        <div class="tally" aria-live="polite">
          <b id="map-count">{points.length}</b> {t.of} {points.length} <span>{t.shown}</span>
        </div>
      </div>

      <div class="mapframe rv" style="--d:.1s">
        <div class="map" id="obs-map" role="region" aria-label={t.title}></div>
        <div class="wheel" id="map-wheel" aria-hidden="true">{t.wheel}</div>
        {
          points.length === 0 && (
            <div class="mempty">
              <div class="mempty-in">
                <span class="beacon" aria-hidden="true" />
                <h2>{t.emptyH}</h2>
                <p>{t.emptyP}</p>
                <a class="btn" href="#zglos">
                  {t.emptyBtn} <span class="arr">↓</span>
                </a>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="scene how">
    <div class="glowspot" style="width:600px;height:600px;left:-220px;top:60px;background:radial-gradient(circle,rgba(125,154,87,.14),transparent 65%)"></div>
    <div class="wrap nopad">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.howNum}</div>
          <h2 class="h-display">{t.howH1} <em>{t.howH2}</em></h2>
        </div>
      </div>
      <ol class="steps">
        {
          t.steps.map(([h, p], i) => (
            <li class="rv" style={`--d:${i * 0.1}s`}>
              <span class="sn">{['I', 'II', 'III', 'IV'][i]}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="scene stats" aria-labelledby="stats-h">
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.statsNum}</div>
          <h2 class="h-display" id="stats-h">{t.statsH} <em>{t.statsHem}</em></h2>
        </div>
      </div>
      <div class="sgrid">
        <article class="sbox rv">
          <h3>{t.byMonth}</h3>
          <div class="hist" id="map-hist" role="img" aria-label={t.byMonth}>
            {t.months.map((m) => (
              <div class="hb">
                <span class="bar" style="--h:0"><b>0</b></span>
                <span class="m">{m}</span>
              </div>
            ))}
          </div>
        </article>
        <article class="sbox rv" style="--d:.1s">
          <h3>{t.latest}</h3>
          <ol class="latest" id="map-latest"></ol>
          <button type="button" class="btn small" id="map-csv">{t.csv} <span class="arr">↓</span></button>
          <p class="hint">{t.csvHint}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="scene formscene" id="zglos">
    <div class="glowspot" style="width:700px;height:700px;right:-260px;top:120px;background:radial-gradient(circle,rgba(232,140,50,.12),transparent 62%)"></div>
    <div class="wrap nopad formgrid">
      <div class="formhead rv">
        <div class="num">{t.formNum}</div>
        <h2 class="h-display">{t.formH1} <em>{t.formH2}</em></h2>
        <p>{t.formP}</p>
        <a class="link" href={routes.key[lang]}>{t.keyLink} →</a>
      </div>
      <div class="rv" style="--d:.1s">
        <SubmitForm lang={lang} mode="observation" />
      </div>
    </div>
  </section>

  <script type="application/json" id="map-data" set:html={JSON.stringify(mapData)} />
</Base>

<script>
  import L from 'leaflet';
  import { addBasemap } from '../scripts/basemap';

  type Pt = {
    species: string;
    latin: string;
    name: string;
    profile: string;
    lat: number;
    lng: number;
    place: string;
    date: string;
    observer: string;
    note: string;
    photo: string;
    iso: string;
    url: string;
  };
  const raw = document.getElementById('map-data')?.textContent;
  const box = document.getElementById('obs-map');
  if (raw && box) {
    const data = JSON.parse(raw) as { points: Pt[]; i18n: { observer: string; profile: string; none: string } };
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const map = L.map(box, { scrollWheelZoom: false, minZoom: 4, maxZoom: 18, zoomSnap: 0.25 });
    void addBasemap(map);
    const poland = L.latLngBounds([49.0, 14.1], [54.85, 24.15]);
    map.fitBounds(poland);

    // kółko myszy nie przechwytuje przewijania strony – dopiero po kliknięciu / fokusie
    const wheel = document.getElementById('map-wheel');
    let hintT = 0;
    box.addEventListener(
      'wheel',
      () => {
        if (map.scrollWheelZoom.enabled() || !wheel) return;
        wheel.classList.add('on');
        clearTimeout(hintT);
        hintT = window.setTimeout(() => wheel.classList.remove('on'), 1400);
      },
      { passive: true },
    );
    map.on('click focus', () => {
      map.scrollWheelZoom.enable();
      wheel?.classList.remove('on');
    });
    map.on('mouseout blur', () => map.scrollWheelZoom.disable());

    const icon = L.divIcon({ className: 'obs-marker', html: '<span class="halo"></span><span class="dot"></span>', iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -12] });
    const layer = L.layerGroup().addTo(map);
    const popup = (p: Pt) => {
      const sp = `<span class="pp-latin">${esc(p.latin)}</span>${p.name ? `<span class="pp-name">${esc(p.name)}</span>` : ''}`;
      return (
        `<div class="pp">` +
        (p.photo ? `<img src="${esc(p.photo)}" alt="${esc(p.latin)}" loading="lazy">` : '') +
        `<div class="pp-b">` +
        (p.profile ? `<a class="pp-sp" href="${esc(p.profile)}">${sp}</a>` : `<div class="pp-sp">${sp}</div>`) +
        `<div class="pp-meta">${esc(p.place)} · ${esc(p.date)}</div>` +
        (p.observer ? `<div class="pp-obs">${esc(data.i18n.observer)}: ${esc(p.observer)}</div>` : '') +
        (p.note ? `<p>${esc(p.note)}</p>` : '') +
        (p.profile ? `<a class="pp-prof" href="${esc(p.profile)}">${esc(data.i18n.profile)}</a>` : '') +
        `</div></div>`
      );
    };
    const count = document.getElementById('map-count');
    const fSp = document.getElementById('map-filter') as HTMLSelectElement | null;
    const fYr = document.getElementById('map-year') as HTMLSelectElement | null;
    let current: Pt[] = data.points;
    const stats = (shown: Pt[]) => {
      // wykres miesięcy
      const byM = Array(12).fill(0) as number[];
      shown.forEach((p) => byM[Number(p.iso.slice(5, 7)) - 1]++);
      const max = Math.max(1, ...byM);
      document.querySelectorAll<HTMLElement>('#map-hist .hb').forEach((el, i) => {
        const bar = el.querySelector<HTMLElement>('.bar');
        if (!bar) return;
        bar.style.setProperty('--h', String(byM[i] / max));
        bar.querySelector('b')!.textContent = String(byM[i]);
        el.classList.toggle('zero', byM[i] === 0);
      });
      // najnowsze
      const list = document.getElementById('map-latest');
      if (list) {
        list.textContent = '';
        const latest = [...shown].sort((a, b) => b.iso.localeCompare(a.iso)).slice(0, 6);
        if (!latest.length) {
          const li = document.createElement('li');
          li.className = 'none';
          li.textContent = data.i18n.none;
          list.append(li);
        }
        latest.forEach((p) => {
          const li = document.createElement('li');
          const a = document.createElement(p.url ? 'a' : 'span');
          a.className = 'll';
          a.textContent = p.latin;
          if (p.url) (a as HTMLAnchorElement).href = p.url;
          const m = document.createElement('span');
          m.className = 'lm';
          m.textContent = `${p.place} · ${p.date}`;
          li.append(a, m);
          list.append(li);
        });
      }
    };
    const draw = (species: string) => {
      layer.clearLayers();
      const yr = fYr?.value ?? '';
      const shown = data.points.filter((p) => (!species || p.species === species) && (!yr || p.iso.startsWith(yr)));
      current = shown;
      stats(shown);
      shown.forEach((p) => L.marker([p.lat, p.lng], { icon, title: `${p.latin} – ${p.place}` }).bindPopup(popup(p), { maxWidth: 260, className: 'obs-popup' }).addTo(layer));
      if (count) count.textContent = String(shown.length);
      if (shown.length && species) {
        const b = L.latLngBounds(shown.map((p) => [p.lat, p.lng] as [number, number]));
        map.flyToBounds(b.pad(0.4), { maxZoom: 9, duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 0.8 });
      } else if (!species) map.fitBounds(poland);
    };
    draw('');
    fSp?.addEventListener('change', () => draw(fSp.value));
    fYr?.addEventListener('change', () => draw(fSp?.value ?? ''));
    document.getElementById('map-csv')?.addEventListener('click', () => {
      const q = (s: string) => `"${String(s).replace(/"/g, '""')}"`;
      const rows = [['species', 'latin', 'date', 'lat', 'lng', 'place', 'observer', 'note'].join(',')].concat(
        current.map((p) => [p.species, p.latin, p.iso, p.lat, p.lng, p.place, p.observer, p.note].map((v) => q(String(v))).join(',')),
      );
      const blob = new Blob(['\ufeff' + rows.join('\n')], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `blattodea-obserwacje-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    if ('ResizeObserver' in window) new ResizeObserver(() => map.invalidateSize()).observe(box);
  }
</script>

<style>
  .stats {
    padding-top: clamp(40px, 6vw, 70px);
    padding-bottom: 0;
  }
  .sgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 14px;
  }
  .sbox {
    border: 1px solid var(--line);
    background: linear-gradient(160deg, var(--bg3), var(--bg2));
    padding: clamp(22px, 2.6vw, 32px);
  }
  .sbox h3 {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 300;
    font-style: italic;
    margin-bottom: 18px;
  }
  .hist {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 6px;
    align-items: end;
    height: 200px;
  }
  .hb {
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100%;
    gap: 6px;
  }
  .bar {
    align-self: end;
    position: relative;
    height: calc(var(--h) * 100%);
    min-height: 3px;
    background: linear-gradient(180deg, var(--amber2), var(--amber));
    border-radius: 2px 2px 0 0;
    transition: height 0.6s var(--ease);
  }
  .bar b {
    position: absolute;
    top: -18px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--amber2);
  }
  .zero .bar {
    background: rgba(255, 255, 255, 0.06);
  }
  .zero .bar b {
    color: var(--dim);
  }
  .hb .m {
    font-size: 10.5px;
    color: var(--muted);
    text-align: center;
  }
  .latest {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .latest :global(li) {
    display: grid;
    gap: 2px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
