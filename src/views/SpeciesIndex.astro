---
import Base from '../layouts/Base.astro';
import CommonsPhoto from '../components/CommonsPhoto.astro';
import { routes, useTranslations, type Lang, type UiKey, tl, pick } from '../i18n/ui';
import { formatPrice, getPricelist, getSpecies } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';

const [species, pricelist] = await Promise.all([getSpecies(), getPricelist()]);
const priceOf = new Map(pricelist.filter((p) => p.data.profile).map((p) => [p.data.profile!, p.data]));
const anySample = species.some((s) => s.data.sample);

const t = pick(lang, {
  pl: {
      num: 'Scena II · profile',
      h1a: 'Profile',
      h1b: 'hodowlane',
      open: 'Otwórz profil',
      cmpLbl: 'porównywarka',
      cmpH: 'Dwa albo trzy gatunki',
      cmpHem: 'obok siebie',
      cmpP: 'Temperatura, wilgotność, pokarm, tempo rozwoju i trudność w jednej tabeli – różnice od razu widać.',
      cmpBtn: 'Porównaj gatunki',
      climbs: 'wspina się',
      flies: 'lata',
      noPrice: 'poza cennikiem',
      dbLbl: 'baza gatunków',
      dbH: 'Wszystkie gatunki',
      dbHem: 'w jednej tabeli',
      dbP: 'Nazwy, systematyka, pochodzenie i trudność hodowli – kliknij nagłówek, żeby posortować.',
      cols: ['Gatunek', 'Rodzina / podrodzina', 'Nazwy w handlu', 'Pochodzenie', 'Trudność'],
  },
  en: {
      num: 'Scene II · care sheets',
      h1a: 'Care',
      h1b: 'sheets',
      open: 'Open care sheet',
      cmpLbl: 'compare',
      cmpH: 'Two or three species',
      cmpHem: 'side by side',
      cmpP: 'Temperature, humidity, diet, development time and difficulty in one table – the differences stand out at once.',
      cmpBtn: 'Compare species',
      climbs: 'climbs',
      flies: 'flies',
      noPrice: 'not in the price list',
      dbLbl: 'species database',
      dbH: 'All species',
      dbHem: 'in one table',
      dbP: 'Names, classification, origin and difficulty – click a header to sort.',
      cols: ['Species', 'Family / subfamily', 'Trade names', 'Origin', 'Difficulty'],
  },
  de: {
      num: 'Szene II · Haltungsprofile',
      h1a: 'Profile',
      h1b: 'zur Haltung',
      open: 'Profil öffnen',
      cmpLbl: 'Vergleich',
      cmpH: 'Zwei oder drei Arten',
      cmpHem: 'nebeneinander',
      cmpP: 'Temperatur, Luftfeuchtigkeit, Futter, Entwicklungsdauer und Schwierigkeit in einer Tabelle – die Unterschiede fallen sofort auf.',
      cmpBtn: 'Arten vergleichen',
      climbs: 'klettert',
      flies: 'fliegt',
      noPrice: 'nicht in der Preisliste',
      dbLbl: 'Artendatenbank',
      dbH: 'Alle Arten',
      dbHem: 'in einer Tabelle',
      dbP: 'Namen, Systematik, Herkunft und Schwierigkeit – zum Sortieren auf eine Spaltenüberschrift klicken.',
      cols: ['Art', 'Familie / Unterfamilie', 'Handelsnamen', 'Herkunft', 'Schwierigkeit'],
  },
});
---

<Base lang={lang} title={tr('species.title')} description={tr('species.lead')} alt={routes.species[other]} active="species">
  <section class="scene sp-scene">
    <div class="glowspot" style="width:640px;height:640px;left:-220px;top:40px;background:radial-gradient(circle,rgba(125,154,87,.15),transparent 65%)"></div>
    <div class="glowspot" style="width:520px;height:520px;right:-180px;bottom:10%;background:radial-gradient(circle,rgba(232,165,71,.11),transparent 65%);animation-delay:-4s"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.num}</div>
          <h1 class="h-display">{t.h1a} <em>{t.h1b}</em></h1>
        </div>
        <div class="rv" style="--d:.15s">
          <p>{tr('species.lead')}</p>
          {anySample && <p class="draft"><b>{tr('sample.badge')}</b> {tr('sample.note')}</p>}
        </div>
      </div>

      <ul class="cards">
        {
          species.map((s, i) => {
            const d = s.data;
            const own = d.gallery[0];
            const price = priceOf.get(s.id);
            const href = `${routes.species[lang]}${s.id}/`;
            return (
              <li class="card rv" style={`--d:${(i % 3) * 0.1}s`}>
                <div class="ph">
                  {own ? (
                    <figure class="ownph">
                      <span class="frame">
                        <img src={own.src} alt={tl(own.alt, lang)} loading="lazy" />
                      </span>
                    </figure>
                  ) : (
                    <CommonsPhoto id={s.id} lang={lang} alt={d.latin} width={960} compact />
                  )}
                  <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {price && <span class={`status st-${price.status} chip`}>{tr(`status.${price.status}`)}</span>}
                </div>
                <div class="body">
                  <div>
                    <h2>
                      <a href={href} class="latin stretch">
                        {d.latin}
                      </a>
                    </h2>
                    <div class="sub">
                      {d.commonName && <b>{tl(d.commonName, lang)}</b>}
                      {d.author && <span> · {d.author}</span>}
                      <span> · {d.family}</span>
                    </div>
                  </div>
                  <dl class="mini">
                    <div>
                      <dt>{tr('species.temperature')}</dt>
                      <dd class="big">{d.temperature}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.size')}</dt>
                      <dd class="big">{tl(d.size, lang)}</dd>
                    </div>
                    <div class="wide">
                      <dt>{tr('species.humidity')}</dt>
                      <dd>{tl(d.humidity, lang)}</dd>
                    </div>
                  </dl>
                  <div class="flags">
                    <span>
                      <span class="diff" aria-hidden="true">
                        {[1, 2, 3].map((k) => (
                          <i class:list={{ on: k <= d.difficulty }} />
                        ))}
                      </span>
                      {tr('species.difficulty').toLowerCase()}: <b>{tr(`species.difficulty.${d.difficulty}` as UiKey)}</b>
                    </span>
                    <span>
                      {t.climbs}: <b>{tr(d.climbs ? 'species.yes' : 'species.no')}</b>
                    </span>
                    <span>
                      {t.flies}: <b>{tr(d.flies ? 'species.yes' : 'species.no')}</b>
                    </span>
                  </div>
                  <div class="foot">
                    {price ? (
                      <span class="from">
                        {formatPrice(price.price, lang)}
                        <small>/ {tr('pack.pcs')} · {tr(`pack.${price.stage}`)}</small>
                      </span>
                    ) : (
                      <span class="lbl">{t.noPrice}</span>
                    )}
                    <span class="go" aria-hidden="true">
                      {t.open} <span class="arr">→</span>
                    </span>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>

      <aside class="cmp panel rv">
        <div>
          <div class="lbl">{t.cmpLbl}</div>
          <h2>
            {t.cmpH} <em>{t.cmpHem}</em>
          </h2>
          <p>{t.cmpP}</p>
        </div>
        <a class="btn" href={routes.compare[lang]}>
          {t.cmpBtn} <span class="arr">→</span>
        </a>
      </aside>

      <section class="db rv" aria-labelledby="db-h">
        <div class="lbl">{t.dbLbl}</div>
        <h2 id="db-h">{t.dbH} <em>{t.dbHem}</em></h2>
        <p class="dbp">{t.dbP}</p>
        <div class="tbl-wrap">
          <table class="tbl" data-sort-table>
            <thead>
              <tr>{t.cols.map((c, i) => <th scope="col"><button type="button" data-col={i}>{c}</button></th>)}</tr>
            </thead>
            <tbody>
              {
                species.map((s) => {
                  const d = s.data;
                  return (
                    <tr>
                      <td data-v={d.latin}>
                        <a class="latin" href={`${routes.species[lang]}${s.id}/`}>{d.latin}</a>
                        {d.author && <span class="auth">{d.author}</span>}
                      </td>
                      <td data-v={`${d.family} ${d.taxonomy?.subfamily ?? ''}`}>
                        {d.family}
                        {d.taxonomy?.subfamily && <span class="auth">{d.taxonomy.subfamily}</span>}
                      </td>
                      <td data-v={d.taxonomy?.tradeNames.join(', ') ?? ''}>{d.taxonomy?.tradeNames.join(', ') || '—'}</td>
                      <td data-v={tl(d.origin, lang)}>{tl(d.origin, lang)}</td>
                      <td data-v={String(d.difficulty)}>{tr(`species.difficulty.${d.difficulty}` as UiKey)}</td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLTableElement>('[data-sort-table]').forEach((tbl) => {
    const body = tbl.tBodies[0];
    let col = -1;
    let dir = 1;
    tbl.querySelectorAll<HTMLButtonElement>('th button').forEach((b) => {
      b.addEventListener('click', () => {
        const c = Number(b.dataset.col);
        dir = c === col ? -dir : 1;
        col = c;
        const rows = [...body.rows].sort(
          (x, y) => dir * (x.cells[c].dataset.v ?? '').localeCompare(y.cells[c].dataset.v ?? '', undefined, { numeric: true }),
        );
        rows.forEach((r) => body.appendChild(r));
        tbl.querySelectorAll('th').forEach((th, i) => th.setAttribute('aria-sort', i === c ? (dir > 0 ? 'ascending' : 'descending') : 'none'));
      });
    });
  });
</script>

<style>
  .sp-scene {
    padding: clamp(120px, 14vw, 170px) 0 clamp(70px, 10vw, 130px);
  }
  .scene-head .draft {
    margin: 18px 0 0;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(14px, 2vw, 24px);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: linear-gradient(150deg, rgba(20, 33, 23, 0.85), rgba(11, 18, 13, 0.9));
    border-radius: 4px;
    overflow: hidden;
    transition:
      border-color 0.5s,
      box-shadow 0.7s,
      translate 0.7s var(--ease);
  }
  .card:hover {
    border-color: rgba(232, 165, 71, 0.45);
    box-shadow: 0 30px 80px -30px rgba(232, 165, 71, 0.25);
    translate: 0 -4px;
  }
  .ph {
    position: relative;
  }
  .ph :global(.frame) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .ph :global(.frame)::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 90% at 45% 45%, transparent 40%, rgba(11, 18, 13, 0.7) 100%),
      linear-gradient(180deg, transparent 60%, rgba(11, 18, 13, 0.7));
  }
  .ph :global(img) {
    transition:
      transform 1.4s var(--ease),
      filter 0.8s;
  }
  .card:hover .ph :global(img) {
    transform: scale(1.06);
  }
  .ph :global(.credit) {
    position: relative;
    z-index: 2;
    padding: 8px 18px 0;
  }
  .ownph {
    margin: 0;
  }
  .ownph .frame {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .ownph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.88);
  }
  .idx {
    position: absolute;
    top: 12px;
    left: 18px;
    z-index: 1;
    font-family: var(--serif);
    font-size: 64px;
    line-height: 1;
    font-weight: 200;
    color: rgba(255, 210, 138, 0.85);
    text-shadow: 0 0 40px rgba(232, 165, 71, 0.5);
    pointer-events: none;
  }
  .chip {
    position: absolute;
    top: 18px;
    right: 16px;
    z-index: 1;
    padding: 6px 10px;
    background: rgba(11, 18, 13, 0.7);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border-radius: 2px;
    pointer-events: none;
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 18px clamp(18px, 2vw, 26px) 22px;
  }
  .body h2 {
    font-size: clamp(28px, 2.6vw, 38px);
    font-weight: 400;
    line-height: 1.08;
  }
  .stretch {
    text-decoration: none;
    transition: color 0.3s;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card:hover .stretch {
    color: var(--amber2);
  }
  .sub {
    color: var(--muted);
    margin-top: 8px;
    font-size: 14px;
  }
  .sub b {
    color: var(--text);
    font-weight: 500;
  }
  .mini {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .mini div {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .mini .wide {
    grid-column: 1 / -1;
  }
  .mini dt {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 3px;
  }
  .mini dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .mini dd.big {
    font-family: var(--serif);
    font-size: 22px;
    color: var(--amber2);
    line-height: 1.1;
  }
  .flags {
    display: flex;
    gap: 8px 18px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }
  .flags b {
    color: var(--text);
    font-weight: 600;
  }
  .diff {
    display: inline-flex;
    gap: 4px;
    vertical-align: middle;
    margin-right: 8px;
  }
  .diff i {
    width: 16px;
    height: 4px;
    background: var(--line2);
    border-radius: 2px;
  }
  .diff i.on {
    background: var(--fern);
    box-shadow: 0 0 8px rgba(169, 191, 127, 0.6);
  }
  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .from {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 30px;
    line-height: 1;
    color: var(--amber2);
  }
  .from small {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .go {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber2);
  }
  .go .arr {
    display: inline-block;
    transition: transform 0.35s;
  }
  .card:hover .go .arr {
    transform: translateX(4px);
  }

  .cmp {
    margin-top: clamp(40px, 6vw, 70px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    flex-wrap: wrap;
    padding: clamp(24px, 3.4vw, 48px);
    overflow: hidden;
    isolation: isolate;
  }
  .cmp::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 520px;
    aspect-ratio: 1;
    right: -160px;
    top: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 165, 71, 0.18), transparent 62%);
    animation: breathe 8s ease-in-out infinite;
  }
  .cmp h2 {
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 300;
    margin: 10px 0 12px;
  }
  .cmp h2 em {
    color: var(--fern);
  }
  .cmp p {
    color: var(--muted);
    margin: 0;
    max-width: 56ch;
  }
  .db {
    margin-top: clamp(60px, 8vw, 110px);
  }
  .db h2 {
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 300;
  }
  .dbp {
    color: var(--muted);
    margin: 8px 0 22px;
  }
  .tbl-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
  }
  .tbl {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
    font-size: 14px;
  }
  .tbl th {
    text-align: left;
    background: var(--bg3);
    border-bottom: 1px solid var(--line2);
  }
  .tbl th button {
    all: unset;
    cursor: pointer;
    display: block;
    padding: 12px 14px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tbl th button:hover,
  .tbl th button:focus-visible {
    color: var(--amber2);
  }
  .tbl th[aria-sort='ascending'] button::after {
    content: ' ↑';
  }
  .tbl th[aria-sort='descending'] button::after {
    content: ' ↓';
  }
  .tbl td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    color: #d3cfbf;
    vertical-align: top;
  }
  .tbl tr:hover td {
    background: rgba(232, 165, 71, 0.05);
  }
  .tbl .latin {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
  }
  .tbl .latin:hover {
    color: var(--amber2);
  }
  .auth {
    display: block;
    font-size: 12px;
    color: var(--dim);
  }
</style>
