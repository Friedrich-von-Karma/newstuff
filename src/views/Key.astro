---
import Base from '../layouts/Base.astro';
import CommonsPhoto from '../components/CommonsPhoto.astro';
import { characters, taxa } from '../data/key';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';

const statusLabel = {
  native: tr('key.native'),
  synanthropic: tr('key.synanthropic'),
  introduced: tr('key.introduced'),
};

const data = {
  characters: characters.map((c) => ({ id: c.id, name: c.name[lang] })),
  taxa: taxa.map((t) => ({ id: t.id, traits: t.traits })),
  i18n: { mismatch: tr('key.mismatch') },
};
---

<Base lang={lang} title={tr('key.title')} description={tr('key.lead')} alt={routes.key[other]} active="key">
  <div class="wrap">
    <header class="titlepage">
      <span class="kicker">Clavis Blattodeorum Poloniae · III</span>
      <h1>{tr('key.title')}</h1>
      <p class="lead">{tr('key.lead')}</p>
    </header>
    <p class="notice">{tr('key.draft')}</p>

    <div class="key">
      <form class="features" aria-labelledby="features-h">
        <span class="clip" aria-hidden="true"></span>
        <div class="fhead">
          <h2 id="features-h">{tr('key.features')}</h2>
          <button type="reset" class="btn dark small">{tr('key.reset')}</button>
        </div>
        {
          characters.map((c, ci) => (
            <fieldset>
              <legend>
                <span class="fn type">{String(ci + 1).padStart(2, '0')}</span> {c.name[lang]}
              </legend>
              {c.help && <p class="help">{c.help[lang]}</p>}
              <div class="states">
                {c.states.map((s) => (
                  <label class="chip">
                    <input type="checkbox" name={c.id} value={s.id} />
                    <span class="txt">{s.label[lang]}</span>
                    <span class="count" data-count={`${c.id}:${s.id}`} />
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
      </form>

      <section class="results" aria-labelledby="results-h">
        <div class="rhead">
          <h2 id="results-h">
            {tr('key.results')}{' '}
            <span class="tally" aria-live="polite">
              <span id="n-match">{taxa.length}</span> {tr('key.of')} {taxa.length}
            </span>
          </h2>
          <label class="showall">
            <input type="checkbox" id="show-all" />
            {tr('key.showAll')}
          </label>
        </div>
        <noscript><p class="muted">{tr('key.noJs')}</p></noscript>
        <p class="none notice" hidden>{tr('key.none')}</p>

        <ol class="taxa">
          {
            taxa.map((t, i) => (
              <li class="taxon" data-id={t.id} data-reveal style={`--d:${(i % 4) * 90}`}>
                <div class="thumb">
                  <CommonsPhoto id={t.id} lang={lang} alt={t.latin} width={500} />
                </div>
                <div class="tbody">
                  <h3>
                    <span class="latin">{t.latin}</span> <span class="auth">{t.author}</span>
                  </h3>
                  {t.name?.[lang] && <p class="vern">{t.name[lang]}</p>}
                  <p class="badges">
                    <span class={`stamp ${t.status}`}>{statusLabel[t.status]}</span>
                    {t.verify && <span class="stamp verify">{tr('key.verify')}</span>}
                  </p>
                  <p class="note">{t.note[lang]}</p>
                  <dl class="facts">
                    <div>
                      <dt>{tr('key.lengthLabel')}</dt>
                      <dd>{t.length}</dd>
                    </div>
                    <div>
                      <dt>{tr('key.habitatLabel')}</dt>
                      <dd>{t.habitat[lang]}</dd>
                    </div>
                  </dl>
                  <p class="why" hidden />
                  {t.profile && (
                    <p class="more">
                      <a href={`${routes.species[lang]}${t.profile}/`}>{tr('pricelist.profileLink')} →</a>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <a class="jump" href="#results-h">
    {tr('key.results')}: <strong id="n-match-bar">{taxa.length}</strong> ↓
  </a>

  <script type="application/json" id="key-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type Data = {
    characters: { id: string; name: string }[];
    taxa: { id: string; traits: Record<string, string[]> }[];
    i18n: { mismatch: string };
  };

  const el = document.getElementById('key-data');
  if (el) {
    const data: Data = JSON.parse(el.textContent || '{}');
    const form = document.querySelector<HTMLFormElement>('form.features')!;
    const showAll = document.querySelector<HTMLInputElement>('#show-all')!;
    const nMatch = document.getElementById('n-match')!;
    const none = document.querySelector<HTMLElement>('.results .none')!;
    const list = document.querySelector<HTMLOListElement>('ol.taxa')!;
    const cards = new Map(
      [...list.querySelectorAll<HTMLLIElement>('li.taxon')].map((li) => [li.dataset.id!, li]),
    );
    const names = new Map(data.characters.map((c) => [c.id, c.name]));

    const selected = () => {
      const sel: Record<string, string[]> = {};
      form.querySelectorAll<HTMLInputElement>('input[type=checkbox]:checked').forEach((i) => {
        (sel[i.name] ||= []).push(i.value);
      });
      return sel;
    };

    /** Lista cech, po których gatunek odpada (pusta = pasuje). */
    const mismatches = (traits: Record<string, string[]>, sel: Record<string, string[]>, skip?: string) =>
      Object.entries(sel)
        .filter(([c]) => c !== skip)
        .filter(([c, states]) => traits[c] && !traits[c].some((s) => states.includes(s)))
        .map(([c]) => c);

    const update = () => {
      const sel = selected();
      const scored = data.taxa.map((t) => ({ t, miss: mismatches(t.traits, sel) }));
      const matching = scored.filter((s) => s.miss.length === 0);

      nMatch.textContent = String(matching.length);
      const bar = document.getElementById('n-match-bar');
      if (bar) bar.textContent = String(matching.length);
      none.hidden = matching.length > 0;

      // kolejność: pasujące, potem wg liczby niezgodności
      scored
        .slice()
        .sort((a, b) => a.miss.length - b.miss.length)
        .forEach(({ t, miss }) => {
          const li = cards.get(t.id)!;
          const ok = miss.length === 0;
          li.classList.toggle('out', !ok);
          li.hidden = !ok && !showAll.checked;
          const why = li.querySelector<HTMLElement>('.why')!;
          why.hidden = ok;
          why.textContent = ok ? '' : `${data.i18n.mismatch}: ${miss.map((m) => names.get(m)).join(', ')}`;
          list.appendChild(li);
        });

      // liczniki: ile gatunków zostanie po zaznaczeniu danego stanu
      form.querySelectorAll<HTMLElement>('[data-count]').forEach((span) => {
        const [c, s] = span.dataset.count!.split(':');
        const n = data.taxa.filter(
          (t) => mismatches(t.traits, sel, c).length === 0 && (!t.traits[c] || t.traits[c].includes(s)),
        ).length;
        span.textContent = String(n);
        span.closest('label')!.classList.toggle('zero', n === 0);
      });
    };

    form.addEventListener('change', update);
    form.addEventListener('reset', () => setTimeout(update));
    showAll.addEventListener('change', update);
    update();
  }
</script>

<style>
  .key {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 980px) {
    .key {
      grid-template-columns: minmax(330px, 400px) minmax(0, 1fr);
    }
    .features {
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 112px);
      overflow: auto;
      scrollbar-width: thin;
    }
  }

  /* karta oznaczania na podkładce */
  .features {
    position: relative;
    padding: 2rem 1.3rem 1.3rem;
    background-color: #fbf8ef;
    background-image: var(--grain);
    border: 1px solid #d6c9a6;
    border-top: 14px solid var(--wood-700);
    box-shadow:
      0 0 0 6px var(--wood-600),
      0 0 0 7px var(--wood-900),
      0 26px 40px -26px rgba(40, 25, 10, 0.8);
    margin: 7px;
  }
  .clip {
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    width: 90px;
    height: 26px;
    border-radius: 4px 4px 2px 2px;
    background: linear-gradient(180deg, #e6e6e6, #9a9a9a 60%, #c9c9c9);
    box-shadow: 0 3px 4px rgba(0, 0, 0, 0.4);
  }
  .fhead,
  .rhead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  h2 {
    font-size: 1.9rem;
    margin: 0;
  }
  fieldset {
    border: 0;
    border-top: 1px dashed var(--rule);
    margin: 1.1rem 0 0;
    padding: 0.9rem 0 0;
    min-width: 0;
  }
  legend {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--bottle-800);
    padding: 0;
    float: left;
    width: 100%;
  }
  .fn {
    font-size: 0.75rem;
    color: var(--stamp-red);
    vertical-align: middle;
  }
  .help {
    clear: both;
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0.1rem 0 0.4rem;
  }
  .states {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.35rem;
  }
  /* zawieszka z etykietą */
  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.5rem 0.38rem 1.25rem;
    background: var(--label);
    border: 1px solid #c9b88c;
    clip-path: polygon(10px 0, 100% 0, 100% 100%, 10px 100%, 0 50%);
    cursor: pointer;
    font-family: var(--f-type);
    font-size: 0.8rem;
    line-height: 1.25;
    transition:
      background 0.25s var(--ease),
      color 0.25s var(--ease),
      translate 0.25s var(--ease);
  }
  .chip::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 50%;
    width: 5px;
    height: 5px;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--paper-3);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.35);
  }
  .chip:hover {
    translate: 2px 0;
    background: #f1e5c2;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip:has(input:focus-visible) {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }
  .chip:has(input:checked) {
    background: var(--bottle-700);
    border-color: var(--bottle-900);
    color: var(--label);
    animation: tick 0.35s var(--ease);
  }
  @keyframes tick {
    50% {
      scale: 1.06;
    }
  }
  .chip.zero:not(:has(input:checked)) {
    opacity: 0.4;
  }
  .count {
    font-family: var(--f-mono);
    font-weight: 700;
    font-size: 0.72rem;
    min-width: 1.6em;
    text-align: center;
    padding: 0.05em 0.35em;
    background: var(--paper-3);
    color: var(--ink-soft);
  }
  .count:empty {
    display: none;
  }
  .chip:has(input:checked) .count {
    background: var(--brass);
    color: var(--wood-900);
  }

  .tally {
    font-family: var(--f-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--wood-600);
    margin-left: 0.5rem;
  }
  #n-match {
    display: inline-block;
    min-width: 1.4ch;
    color: var(--stamp-red);
    font-size: 1.4rem;
  }
  .showall {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    font-family: var(--f-type);
    font-size: 0.8rem;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .showall input {
    accent-color: var(--bottle-600);
  }
  .results .none {
    margin-top: 1rem;
  }
  .taxa {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 1.5rem;
  }
  /* karta gatunku */
  .taxon {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 240px) 1fr;
    gap: 1.4rem;
    background: #fbf8ef;
    border: 1px solid #d6c9a6;
    padding: 1.1rem;
    box-shadow: 0 18px 28px -22px rgba(40, 25, 10, 0.7);
    transition:
      opacity 0.4s var(--ease),
      filter 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .taxon::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--bottle-600);
    transition: background 0.4s;
  }
  .taxon:hover {
    box-shadow: 0 24px 34px -20px rgba(40, 25, 10, 0.7);
  }
  .taxon.out {
    opacity: 0.5;
    filter: grayscale(0.85);
  }
  .taxon.out::before {
    background: var(--rule);
  }
  .thumb {
    align-self: start;
    background: #fff;
    padding: 5px 5px 0;
    box-shadow: 0 6px 12px -6px rgba(0, 0, 0, 0.45);
    rotate: -1deg;
    transition: rotate 0.4s var(--ease);
  }
  .taxon:nth-child(even) .thumb {
    rotate: 1deg;
  }
  .taxon:hover .thumb {
    rotate: 0deg;
  }
  .taxon:hover .thumb :global(img) {
    scale: 1.06;
  }
  .thumb :global(.credit) {
    font-size: 0.56rem;
    padding: 0.35rem 0.1rem 0.4rem;
  }
  h3 {
    font-size: 1.75rem;
    margin: 0;
    line-height: 1.05;
  }
  .auth {
    font-family: var(--f-type);
    font-size: 0.72rem;
    font-weight: normal;
    color: var(--ink-faint);
  }
  .vern {
    margin: 0.15rem 0 0;
    color: var(--ink-soft);
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0.8rem 0 0.8rem 0.2rem;
  }
  .badges .stamp {
    font-size: 0.7rem;
  }
  .note {
    margin: 0 0 0.7rem;
    font-size: 0.97rem;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
    border-top: 1px dotted var(--rule);
    padding-top: 0.5rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.5rem;
  }
  .facts dt {
    font-family: var(--f-caps);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--wood-600);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-soft);
  }
  .why {
    margin: 0.6rem 0 0;
    font-family: var(--f-type);
    font-size: 0.78rem;
    color: var(--stamp-red);
  }
  .more {
    margin: 0.7rem 0 0;
    font-family: var(--f-caps);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .jump {
    display: none;
  }
  @media (max-width: 979px) {
    .jump {
      display: block;
      position: fixed;
      left: 50%;
      translate: -50% 0;
      bottom: 14px;
      z-index: 30;
      font-family: var(--f-caps);
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--wood-900);
      background: linear-gradient(180deg, #ecd6a2, #c9a463 48%, #b08a4c 52%, #d2b072);
      border: 1px solid var(--brass-dark);
      text-decoration: none;
      padding: 0.55rem 1.2rem;
      box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.55);
      white-space: nowrap;
    }
  }
  @media (max-width: 640px) {
    .taxon {
      grid-template-columns: 1fr;
    }
    .thumb {
      max-width: 320px;
    }
  }
</style>
