---
import Base from '../layouts/Base.astro';
import CommonsPhoto from '../components/CommonsPhoto.astro';
import { characters, taxa } from '../data/key';
import { photos } from '../data/photos';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';

const t = pl
  ? {
      num: 'Klucz · oznaczanie',
      h1a: 'Klucz do karaczanów',
      h1b: 'Polski',
      draftB: 'Wersja robocza',
      draftTxt: 'dane i cechy wymagają jeszcze weryfikacji',
      how: 'Klucz wielodostępny: zaznaczaj widoczne cechy w dowolnej kolejności – lista gatunków zawęża się na bieżąco, a liczby przy cechach pokazują, ile gatunków zostanie po ich zaznaczeniu. Kilka stanów tej samej cechy łączy się przez „lub”.',
      hide: 'Ukryj cechy',
      show: 'Pokaż cechy',
      showMobile: 'Cechy',
      match: 'pasuje',
      clear: 'wyczyść',
      remove: 'usuń',
      drawerHelp: 'Zaznacz to, co widzisz. Gatunek bez danych dla cechy (np. nieznany samiec) nie jest po niej wykluczany.',
      close: 'Zamknij panel cech',
      showResults: 'Pokaż wyniki',
      noPhoto: 'brak zdjęcia',
      noPhoto2: 'na wolnej licencji',
      ctaNum: 'Dalej',
      ctaH1: 'Nie jesteś',
      ctaH2: 'pewien?',
      ctaP: 'Wyślij zdjęcia z góry i z boku, długość ciała oraz miejsce znalezienia – zgłoszenie trafi mailem do autora strony.',
      ctaBtn: 'Oznacz mojego karaczana',
      mapP: 'Zweryfikowane zgłoszenia trafiają na mapę obserwacji karaczanów w Polsce.',
      mapBtn: 'Mapa obserwacji',
      glossBtn: 'Słowniczek pojęć',
      chars: 'cech zaznaczonych',
    }
  : {
      num: 'Key · identification',
      h1a: 'Key to the cockroaches of',
      h1b: 'Poland',
      draftB: 'Draft version',
      draftTxt: 'data and features still need verification',
      how: 'A multi-access key: tick the visible features in any order – the species list narrows down as you go, and the numbers next to each feature show how many species would remain. Several states of the same feature are combined with “or”.',
      hide: 'Hide features',
      show: 'Show features',
      showMobile: 'Features',
      match: 'matching',
      clear: 'clear',
      remove: 'remove',
      drawerHelp: 'Tick what you can see. A species with no data for a feature (e.g. an unknown male) is not excluded by it.',
      close: 'Close the features panel',
      showResults: 'Show results',
      noPhoto: 'no photo',
      noPhoto2: 'under a free licence yet',
      ctaNum: 'Next',
      ctaH1: 'Not',
      ctaH2: 'sure?',
      ctaP: 'Send photos from above and from the side, the body length and where you found it – your submission goes by e-mail to the site’s author.',
      ctaBtn: 'Identify my cockroach',
      mapP: 'Verified records go onto the map of cockroach observations in Poland.',
      mapBtn: 'Observation map',
      glossBtn: 'Glossary',
      chars: 'features ticked',
    };

const statusLabel = {
  native: tr('key.native'),
  synanthropic: tr('key.synanthropic'),
  introduced: tr('key.introduced'),
};

const data = {
  characters: characters.map((c) => ({
    id: c.id,
    name: c.name[lang],
    states: Object.fromEntries(c.states.map((s) => [s.id, s.label[lang]])),
  })),
  taxa: taxa.map((x) => ({ id: x.id, traits: x.traits })),
  i18n: { hide: t.hide, show: t.show, remove: t.remove },
};
---

<Base lang={lang} title={tr('key.title')} description={tr('key.lead')} alt={routes.key[other]} active="key">
  <section class="page keypage">
    <div class="glowspot" style="width:620px;height:620px;right:-200px;top:40px;background:radial-gradient(circle,rgba(232,165,71,.12),transparent 65%)"></div>
    <div class="glowspot" style="width:560px;height:560px;left:-240px;top:900px;background:radial-gradient(circle,rgba(125,154,87,.13),transparent 65%);animation-delay:-4s"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.num}</div>
          <h1 class="h-display">{t.h1a} <em>{t.h1b}</em></h1>
          <div class="draft"><b>{t.draftB}</b> {t.draftTxt}</div>
        </div>
        <div class="rv" style="--d:.15s">
          <p>{t.how}</p>
          <p class="drafttxt" data-glossary>{tr('key.draft')}</p>
        </div>
      </div>

      <div class="keybar" id="keybar">
        <div class="kb-l">
          <button class="tog" type="button" id="key-tog" aria-controls="key-drawer" aria-expanded="true">
            <span class="ic" aria-hidden="true"><i></i><i></i><i></i></span><span id="tog-txt">{t.hide}</span>
          </button>
          <div class="tally" aria-live="polite">
            {t.match} <b id="n-match">{taxa.length}</b> {tr('key.of')} <span>{taxa.length}</span>
          </div>
        </div>
        <div class="kb-r">
          <div class="chips" id="chips"></div>
          <button class="clear" type="button" id="clear-all" hidden>{t.clear}</button>
        </div>
      </div>

      <div class="keyl" id="keyl">
        <aside class="drawer" id="key-drawer" aria-label={tr('key.features')}>
          <div class="drawer-h">
            <h2>{tr('key.features')}</h2>
            <button class="dclose" type="button" id="dclose" aria-label={t.close}>×</button>
          </div>
          <p class="dhelp">{t.drawerHelp}</p>
          <form id="key-form">
            {
              characters.map((c, ci) => (
                <fieldset class="ch">
                  <legend>
                    <span class="fn">{String(ci + 1).padStart(2, '0')}</span>
                    {c.name[lang]}
                  </legend>
                  {c.help && <p class="help">{c.help[lang]}</p>}
                  {c.states.map((s) => (
                    <label class="stt" data-c={c.id} data-s={s.id}>
                      <input type="checkbox" name={c.id} value={s.id} />
                      <span class="lab">{s.label[lang]}</span>
                      <span class="cnt">–</span>
                    </label>
                  ))}
                </fieldset>
              ))
            }
          </form>
          <button class="btn small dres" type="button" id="dres">{t.showResults} <span class="arr">→</span></button>
        </aside>

        <div class="resbox">
          <noscript><p class="muted">{tr('key.noJs')}</p></noscript>
          <div class="results" id="results">
            {
              taxa.map((x, i) => {
                const vern = x.name?.[lang];
                return (
                  <article class="tx rv" data-id={x.id} style={`--d:${(i % 3) * 0.08}s`}>
                    <div class="tx-ph">
                      {photos[x.id] ? (
                        <CommonsPhoto id={x.id} lang={lang} alt={vern ? `${x.latin} – ${vern}` : x.latin} width={500} compact />
                      ) : (
                        <div class="phbox">
                          <span class="nophoto">
                            <b>{t.noPhoto}</b>
                            {t.noPhoto2}
                          </span>
                        </div>
                      )}
                      <span class={`st st-${x.status}`}>{statusLabel[x.status]}</span>
                    </div>
                    <div class="tx-b">
                      <h3>
                        <span class="latin">{x.latin}</span> <small>{x.author}</small>
                      </h3>
                      {vern && <div class="pln">{vern}</div>}
                      <div class="meta">
                        <span>{x.length}</span>
                      </div>
                      <div class="hab">{x.habitat[lang]}</div>
                      <p data-glossary>{x.note[lang]}</p>
                      <a class="prof" href={`${routes.wild[lang]}${x.id}/`}>
                        → {lang === 'pl' ? 'Karta gatunku' : 'Species page'}
                      </a>
                      {x.profile && (
                        <a class="prof" href={`${routes.species[lang]}${x.profile}/`}>
                          → {tr('pricelist.profileLink')}
                        </a>
                      )}
                      {x.verify && <div class="ver">{tr('key.verify')}</div>}
                    </div>
                  </article>
                );
              })
            }
            <div class="empty" id="empty" hidden>{tr('key.none')}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="scrim" id="key-scrim" aria-hidden="true"></div>
  </section>

  <section class="scene cta">
    <div class="glowspot" style="width:700px;height:700px;left:50%;top:-80px;margin-left:-350px;background:radial-gradient(circle,rgba(232,140,50,.16),transparent 62%)"></div>
    <div class="wrap cta-in">
      <div class="rv">
        <div class="num">{t.ctaNum}</div>
        <h2 class="h-display">{t.ctaH1} <em>{t.ctaH2}</em></h2>
      </div>
      <div class="cta-side rv" style="--d:.15s">
        <p>{t.ctaP}</p>
        <a class="btn" href={routes.identify[lang]}>{t.ctaBtn} <span class="arr">→</span></a>
        <p class="mapline">{t.mapP}</p>
        <div class="cta-links">
          <a class="link" href={routes.map[lang]}>{t.mapBtn} →</a>
          <a class="link" href={routes.glossary[lang]}>{t.glossBtn} →</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="key-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  type Data = {
    characters: { id: string; name: string; states: Record<string, string> }[];
    taxa: { id: string; traits: Record<string, string[]> }[];
    i18n: { hide: string; show: string; remove: string };
  };

  const raw = document.getElementById('key-data')?.textContent;
  if (raw) {
    const data: Data = JSON.parse(raw);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = $<HTMLFormElement>('key-form');
    const results = $('results');
    const nMatch = $('n-match');
    const chips = $('chips');
    const clearAll = $<HTMLButtonElement>('clear-all');
    const empty = $('empty');
    const cards = new Map([...results.querySelectorAll<HTMLElement>('.tx')].map((el) => [el.dataset.id!, el]));
    const labels = [...form.querySelectorAll<HTMLLabelElement>('.stt')];

    const selection = () => {
      const sel: Record<string, string[]> = {};
      form.querySelectorAll<HTMLInputElement>('input:checked').forEach((i) => (sel[i.name] ||= []).push(i.value));
      return sel;
    };
    const matches = (traits: Record<string, string[]>, sel: Record<string, string[]>, skip?: string) => {
      for (const c in sel) {
        if (c === skip) continue;
        const tr = traits[c];
        if (!tr) continue;
        if (!sel[c].some((s) => tr.includes(s))) return false;
      }
      return true;
    };

    const update = () => {
      const sel = selection();
      let n = 0;
      for (const tx of data.taxa) {
        const el = cards.get(tx.id)!;
        const ok = matches(tx.traits, sel);
        if (ok) {
          n++;
          if (el.classList.contains('gone')) {
            el.classList.remove('gone');
            el.classList.add('in');
            if (!reduce) {
              el.classList.remove('pop');
              void el.offsetWidth;
              el.classList.add('pop');
            }
          }
        } else el.classList.add('gone');
      }
      empty.hidden = n > 0;
      if (nMatch.textContent !== String(n)) {
        nMatch.textContent = String(n);
        if (!reduce) nMatch.animate([{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'none' }], { duration: 350 });
      }
      for (const l of labels) {
        const c = l.dataset.c!;
        const s = l.dataset.s!;
        const k = data.taxa.filter((tx) => matches(tx.traits, sel, c) && (!tx.traits[c] || tx.traits[c].includes(s))).length;
        l.querySelector('.cnt')!.textContent = String(k);
        l.classList.toggle('zero', k === 0 && !l.querySelector('input')!.checked);
      }
      chips.textContent = '';
      let any = false;
      for (const c of data.characters) {
        for (const s of sel[c.id] || []) {
          any = true;
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip';
          b.textContent = c.states[s];
          b.title = `${c.name}: ${c.states[s]} – ${data.i18n.remove}`;
          b.addEventListener('click', () => {
            const inp = form.querySelector<HTMLInputElement>(`input[name="${c.id}"][value="${s}"]`);
            if (inp) inp.checked = false;
            update();
          });
          chips.appendChild(b);
        }
      }
      clearAll.hidden = !any;
    };
    form.addEventListener('change', update);
    clearAll.addEventListener('click', () => {
      form.reset();
      update();
    });
    update();

    // panel cech: obok wyników (zwijany) na komputerze, wysuwany z boku na telefonie
    const keyl = $('keyl');
    const tog = $<HTMLButtonElement>('key-tog');
    const togTxt = $('tog-txt');
    const drawer = $('key-drawer');
    const mq = matchMedia('(max-width: 1100px)');
    let open = !mq.matches;
    const setDrawer = (o: boolean, focus = false) => {
      open = o;
      keyl.classList.toggle('collapsed', !o);
      document.documentElement.classList.toggle('key-open', o && mq.matches);
      tog.setAttribute('aria-expanded', String(o));
      togTxt.textContent = o ? data.i18n.hide : data.i18n.show;
      drawer.toggleAttribute('inert', !o);
      if (focus && o) drawer.querySelector<HTMLElement>('input')?.focus({ preventScroll: true });
    };
    const init = () => setDrawer(!mq.matches);
    init();
    mq.addEventListener('change', init);
    tog.addEventListener('click', () => setDrawer(!open, mq.matches));
    $('dclose').addEventListener('click', () => {
      setDrawer(false);
      tog.focus();
    });
    $('dres').addEventListener('click', () => {
      setDrawer(false);
      $('keybar').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
    $('key-scrim').addEventListener('click', () => setDrawer(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open && mq.matches) {
        setDrawer(false);
        tog.focus();
      }
    });
  }
</script>

<style>
  /* bez isolation: wysuwany panel cech (fixed) musi przykryć nagłówek strony */
  .keypage {
    position: relative;
    overflow-x: clip;
  }
  .scene-head .draft {
    margin-top: 26px;
  }
  .drafttxt {
    margin-top: 1em !important;
    font-size: 13.5px;
    color: var(--dim) !important;
  }

  /* pasek klucza */
  .keybar {
    position: sticky;
    top: 84px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 14px;
    flex-wrap: wrap;
    padding: 12px 16px;
    margin-bottom: 22px;
    border: 1px solid var(--line);
    background: rgba(15, 25, 18, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-radius: 4px;
  }
  .kb-l,
  .kb-r {
    display: flex;
    align-items: center;
    gap: 10px 14px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .tog {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    background: none;
    border: 1px solid var(--amber);
    color: var(--amber2);
    padding: 9px 16px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background 0.3s;
  }
  .tog:hover {
    background: rgba(232, 165, 71, 0.14);
  }
  .tog .ic {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
  }
  .tog .ic i {
    display: block;
    height: 1.5px;
    background: currentColor;
    width: 16px;
  }
  .tog .ic i:nth-child(2) {
    width: 10px;
  }
  .tog .ic i:nth-child(3) {
    width: 13px;
  }
  .tally {
    font-family: var(--serif);
    font-size: 18px;
    color: var(--muted);
    white-space: nowrap;
  }
  .tally b {
    font-weight: 400;
    color: var(--amber2);
    font-size: 26px;
    display: inline-block;
    min-width: 1.2ch;
    text-align: right;
  }
  .chips {
    display: flex;
    gap: 6px 10px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .chips :global(.chip) {
    border: 0;
    border-bottom: 1px solid var(--moss2);
    background: none;
    color: var(--fern);
    font-size: 12.5px;
    padding: 3px 2px;
    cursor: pointer;
    text-align: left;
    animation: chipin 0.4s var(--ease);
  }
  .chips :global(.chip:hover) {
    color: var(--amber2);
    border-color: var(--amber);
  }
  .chips :global(.chip)::after {
    content: ' ×';
    color: var(--amber);
  }
  @keyframes chipin {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .clear {
    background: none;
    border: 0;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font-size: 13px;
  }
  .clear:hover {
    color: var(--amber2);
  }

  /* układ: panel cech + wyniki */
  .keyl {
    display: grid;
    grid-template-columns: 350px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    transition:
      grid-template-columns 0.6s var(--ease),
      gap 0.6s var(--ease);
  }
  .keyl.collapsed {
    grid-template-columns: 0px minmax(0, 1fr);
    gap: 0;
  }
  .drawer {
    position: sticky;
    top: 160px;
    max-height: calc(100vh - 180px);
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(20, 33, 23, 0.75), rgba(11, 18, 13, 0.85));
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-radius: 4px;
    padding: 22px 20px;
    transition:
      transform 0.6s var(--ease),
      opacity 0.5s;
    scrollbar-width: thin;
    scrollbar-color: var(--moss) transparent;
  }
  .keyl.collapsed .drawer {
    transform: translateX(-110%);
    opacity: 0;
    pointer-events: none;
  }
  .drawer-h {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .drawer-h h2 {
    font-size: 26px;
    font-style: italic;
  }
  .dclose {
    display: none;
    background: none;
    border: 1px solid var(--line2);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 18px;
  }
  .dhelp {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .dres {
    display: none;
  }
  .ch {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 0;
    padding: 16px 0 12px;
    min-width: 0;
  }
  .ch legend {
    float: left;
    width: 100%;
    font-family: var(--serif);
    font-size: 18px;
    padding: 0;
    margin-bottom: 4px;
  }
  .fn {
    font-style: italic;
    font-size: 13px;
    color: var(--amber);
    margin-right: 8px;
  }
  .help {
    clear: both;
    font-size: 12px;
    color: var(--dim);
    margin: 0 0 8px;
    line-height: 1.45;
  }
  .stt {
    clear: both;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 6px;
    margin: 0 -6px;
    cursor: pointer;
    border-radius: 3px;
    font-size: 14px;
    line-height: 1.35;
    transition:
      background 0.25s,
      opacity 0.3s;
  }
  .stt:hover {
    background: rgba(235, 229, 211, 0.05);
  }
  .stt input {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 17px;
    height: 17px;
    margin: 1px 0 0;
    border: 1px solid var(--line2);
    border-radius: 2px;
    background: transparent;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.25s;
  }
  .stt input:checked {
    background: var(--amber);
    border-color: var(--amber);
    box-shadow: 0 0 12px rgba(232, 165, 71, 0.6);
  }
  .stt input:checked::after {
    content: '';
    width: 8px;
    height: 4px;
    border: 2px solid #1a1208;
    border-top: 0;
    border-right: 0;
    transform: rotate(-45deg) translate(1px, -1px);
  }
  .stt input:focus-visible {
    outline: 2px solid var(--amber2);
    outline-offset: 2px;
  }
  .stt .lab {
    flex: 1;
  }
  .stt .cnt {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--fern);
    min-width: 2ch;
    text-align: right;
  }
  .stt.zero {
    opacity: 0.38;
  }
  .stt.zero .cnt {
    color: var(--dim);
  }

  /* wyniki */
  .resbox {
    min-width: 0;
  }
  .results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 16px;
  }
  .tx {
    border: 1px solid var(--line);
    background: var(--bg2);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.4s,
      transform 0.5s var(--ease),
      box-shadow 0.6s;
  }
  .tx:hover {
    border-color: rgba(232, 165, 71, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -34px rgba(232, 165, 71, 0.3);
  }
  .tx.gone {
    display: none;
  }
  .tx.pop {
    animation: pop 0.7s var(--ease);
  }
  @keyframes pop {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
  .tx-ph {
