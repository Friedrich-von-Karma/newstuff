---
import Base from '../layouts/Base.astro';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
---

<Base lang={lang} title={tr('404.title')} alt={lang === 'pl' ? routes.home.en : routes.home.pl}>
  <div class="wrap nf">
    <p class="big caps">404</p>
    <h1>{tr('404.title')}</h1>
    <p class="lead">{tr('404.text')}</p>
    <p><a class="btn" href={routes.home[lang]}>{tr('404.back')}</a></p>
  </div>
</Base>

<style>
  .nf {
    text-align: center;
    padding-top: 4rem;
  }
  .big {
    font-size: clamp(6rem, 20vw, 11rem);
    line-height: 1;
    margin: 0;
    color: var(--brass-dark);
    opacity: 0.6;
  }
  .lead {
    color: var(--ink-soft);
    font-style: italic;
  }
</style>
