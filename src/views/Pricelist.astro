---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';
import { formatPrice, getPricelist, getPricelistUpdated, getSpecies } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';

const [items, species] = await Promise.all([getPricelist(), getSpecies()]);
const speciesById = new Map(species.map((s) => [s.id, s]));
const anySample = items.some((i) => i.data.sample);
const updatedIso = getPricelistUpdated();
const updatedDate = updatedIso ? new Date(`${updatedIso}T12:00:00`) : null;
const updatedText = updatedDate && !isNaN(updatedDate.valueOf()) ? formatDate(updatedDate, lang) : '';

const t = pl
  ? {
      num: 'Scena I · cennik',
      h1a: 'Cennik',
      h1b: 'na żywo',
      intro:
        'Ceny za paczkę <strong>10 sztuk</strong>. Każdy gatunek sprzedaję w jednym wariancie – jako nimfy, mix (nimfy i imago) albo imago. Kliknij nazwę gatunku, żeby zobaczyć jego profil hodowlany i zamówić.',
      updated: 'cennik zaktualizowany',
      pack: 'Paczka = 10 sztuk wybranego wariantu',
      cart: 'Zobacz koszyk',
      shown: 'widoczne',
      profile: 'Profil hodowlany',
      nophoto: 'brak zdjęcia',
      shipLbl: 'wysyłka, odbiór, płatność',
      shipH: 'Jak podróżują paczki',
      howNum: 'Jak zamówić',
      howH: 'Trzy kroki',
      howHem: 'do paczki',
      steps: [
        ['Kliknij gatunek', 'Na liście powyżej. Otworzy się jego profil hodowlany z ceną i przyciskiem „Do koszyka”.'],
        ['Dodaj do koszyka', 'Możesz zebrać kilka gatunków, także po kilka paczek tego samego.'],
        ['Wyślij jednym mailem', 'Koszyk przygotuje wiadomość z całym zamówieniem. W odpowiedzi dostaniesz potwierdzenie dostępności i koszt wysyłki.'],
      ],
      wait: 'Gatunku chwilowo brak albo pojawi się wkrótce? Kliknij „Powiadom mnie” w jego profilu – wiadomość zapisze Cię na listę oczekujących.',
      note: 'Ceny w złotych za paczkę 10 szt. · stan hodowli zmienia się z tygodnia na tydzień',
      compare: 'Porównaj gatunki',
      stageH: 'W paczce',
      priceH: 'Cena za 10 szt.',
    }
  : {
      num: 'Scene I · price list',
      h1a: 'Price list',
      h1b: 'live',
      intro:
        'Prices per pack of <strong>10</strong>. Each species is sold in one form – as nymphs, a mix (nymphs and adults) or adults. Click a species name to see its care sheet and order.',
      updated: 'price list updated',
      pack: 'Pack = 10 individuals of the chosen option',
      cart: 'View cart',
      shown: 'shown',
      profile: 'Care sheet',
      nophoto: 'no photo',
      shipLbl: 'shipping, pickup, payment',
      shipH: 'How the parcels travel',
      howNum: 'How to order',
      howH: 'Three steps',
      howHem: 'to a parcel',
      steps: [
        ['Click a species', 'In the list above. Its care sheet opens with the price and an “Add to cart” button.'],
        ['Add it to the cart', 'Collect several species – or several packs of the same one.'],
        ['Send one e-mail', 'The cart prepares a message with your whole order. The reply confirms availability and the shipping cost.'],
      ],
      wait: 'Species out of stock or coming soon? Click “Notify me” on its care sheet – the message adds you to the waiting list.',
      note: 'Prices in PLN per pack of 10 · stock changes from week to week',
      compare: 'Compare species',
      stageH: 'In the pack',
      priceH: 'Price per 10',
    };

---

<Base lang={lang} title={tr('pricelist.title')} description={tr('pricelist.lead')} alt={routes.pricelist[other]} active="pricelist">
  <section class="scene pl-scene">
    <div class="glowspot" style="width:560px;height:560px;right:-160px;top:40px;background:radial-gradient(circle,rgba(232,165,71,.14),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.num}</div>
          <h1 class="h-display">{t.h1a} <em>{t.h1b}</em></h1>
        </div>
        <div class="rv intro" style="--d:.15s">
          <p set:html={t.intro} />
          {updatedText && (
            <p class="upd">
              {t.updated}: <time datetime={updatedIso}>{updatedText}</time>
            </p>
          )}
          {anySample && <p class="draft"><b>{tr('sample.badge')}</b> {tr('sample.note')}</p>}
        </div>
      </div>

      <div class="list rv" style="--d:.2s" role="table" aria-label={tr('pricelist.title')}>
        <div class="row head" role="row">
          <span role="columnheader">{tr('pricelist.species')}</span>
          <span class="stg" role="columnheader">{t.stageH}</span>
          <span class="pc" role="columnheader">{t.priceH}</span>
        </div>
        {
          items.map((item) => {
            const d = item.data;
            const profile = d.profile ? speciesById.get(d.profile) : undefined;
            const href = profile ? `${routes.species[lang]}${profile.id}/` : undefined;
            return (
              <div class:list={['row', { dim: d.status === 'out' }]} role="row">
                <span class="name" role="cell">
                  {href ? (
                    <a class="latin" href={href}>
                      {d.latin}
                      <span class="arr" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="latin">{d.latin}</span>
                  )}
                  {d.status !== 'available' && <span class={`st st-${d.status}`}>{tr(`status.${d.status}`)}</span>}
                </span>
                <span class="stg" role="cell">{tr(`pack.${d.stage}`)}</span>
                <span class="pc" role="cell">{formatPrice(d.price, lang)}</span>
              </div>
            );
          })
        }
        {items.length === 0 && <p class="empty">{tr('pricelist.empty')}</p>}
      </div>
      <div class="pack-note rv">{t.note}</div>

      <div class="ship-box glass rv">
        <div class="lbl">{t.shipLbl}</div>
        <ul class="ship">
          {site.shipping[lang].map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="scene how-scene">
    <div class="glowspot" style="width:620px;height:620px;left:-220px;top:0;background:radial-gradient(circle,rgba(125,154,87,.14),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.howNum}</div>
          <h2 class="h-display">{t.howH} <em>{t.howHem}</em></h2>
        </div>
        <p class="rv" style="--d:.15s">{tr('contact.orderHint')}</p>
      </div>
      <ol class="steps">
        {
          t.steps.map(([h, p], i) => (
            <li class="step glass rv" style={`--d:${i * 0.12}s`}>
              <span class="roman" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
      <p class="waitnote rv" data-glossary>
        <span class="bell" aria-hidden="true">◔</span>
        {t.wait}
      </p>
      <div class="cta rv">
        <button type="button" class="btn" data-open-cart>{t.cart} <span class="arr">→</span></button>
        <a class="btn quiet" href={routes.compare[lang]}>{t.compare} <span class="arr">→</span></a>
        <a class="link" href={routes.species[lang]}>{tr('nav.species')}</a>
      </div>
    </div>
  </section>
</Base>


<style>
  .pl-scene {
    padding: clamp(120px, 14vw, 170px) 0 clamp(40px, 6vw, 80px);
  }
  .intro :global(strong) {
    color: var(--text);
  }
  .intro .draft {
    margin: 18px 0 0;
  }
  .upd {
    margin: 14px 0 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .upd time {
    color: var(--amber2);
  }

  /* lista cen */
  .list {
    border-top: 1px solid var(--line2);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem 9rem;
    align-items: baseline;
    gap: 12px 20px;
    padding: 18px 8px;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s;
  }
  .row:not(.head):hover {
    background: linear-gradient(90deg, rgba(232, 165, 71, 0.07), transparent 70%);
  }
  .head {
    padding-top: 12px;
    padding-bottom: 12px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pc {
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .row:not(.head) .pc {
    font-family: var(--serif);
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--amber2);
  }
  .stg {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fern);
  }
  .head .stg {
    color: var(--muted);
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    min-width: 0;
  }
  .latin {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.15;
    color: var(--text);
  }
  a.latin {
    text-decoration: none;
    background: linear-gradient(var(--amber), var(--amber)) 0 100% / 0 1px no-repeat;
    transition:
      color 0.3s,
      background-size 0.45s var(--ease);
  }
  a.latin:hover,
  a.latin:focus-visible {
    color: var(--amber2);
    background-size: 100% 1px;
  }
  .latin .arr {
    display: inline-block;
    margin-left: 10px;
    font-style: normal;
    font-size: 0.6em;
    color: var(--amber);
    opacity: 0.6;
    transition:
      transform 0.4s var(--ease),
      opacity 0.3s;
  }
  a.latin:hover .arr {
    transform: translateX(6px);
    opacity: 1;
  }
  .st {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid var(--line2);
    color: var(--muted);
  }
  .st-low {
    color: var(--amber2);
    border-color: rgba(232, 165, 71, 0.45);
  }
  .st-soon {
    color: var(--fern);
    border-color: rgba(169, 191, 127, 0.45);
  }
  .dim .latin,
  .dim .pc {
    opacity: 0.55;
  }
  .list .empty {
    margin: 20px 0;
  }
  .pack-note {
    margin-top: 22px;
    color: var(--muted);
    font-size: 13px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .pack-note::before {
    content: '';
    flex: none;
    width: 24px;
    height: 1px;
    background: var(--amber);
  }

  /* wysyłka */
  .ship-box {
    margin-top: 40px;
    padding: clamp(20px, 2.6vw, 32px);
    max-width: 760px;
  }
  .ship-box .lbl {
    margin-bottom: 14px;
  }
  .ship {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: s;
    display: grid;
    gap: 10px;
  }
  .ship li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 8px;
    font-size: 14px;
    color: #d3cfbf;
    line-height: 1.5;
  }
  .ship li::before {
    content: counter(s, upper-roman);
    font-family: var(--serif);
    font-style: italic;
    color: var(--amber);
    font-size: 14px;
  }

  /* jak zamówić */
  .how-scene {
    padding-left: 0;
    padding-right: 0;
    padding-top: clamp(40px, 6vw, 80px);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .step {
    position: relative;
    padding: clamp(22px, 2.6vw, 36px);
    overflow: hidden;
  }
  .roman {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 200;
    font-size: clamp(56px, 6vw, 88px);
    line-height: 0.9;
    color: var(--amber2);
    text-shadow: 0 0 40px rgba(232, 165, 71, 0.4);
    margin-bottom: 18px;
  }
  .step h3 {
    font-size: clamp(24px, 2.2vw, 32px);
    font-style: italic;
    margin-bottom: 10px;
  }
  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .waitnote {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 26px 0 0;
    max-width: 70ch;
    color: #d3cfbf;
    font-size: 15px;
  }
  .bell {
    color: var(--amber);
    font-size: 18px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    align-items: center;
    margin-top: 34px;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .head {
      display: none;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
      padding: 16px 4px;
    }
    .name {
      grid-column: 1 / -1;
    }
  }
</style>
