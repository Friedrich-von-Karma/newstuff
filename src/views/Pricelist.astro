---
import { glassSurface } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import Base from '../layouts/Base.astro';
import PriceList from '../components/PriceList.astro';
import { site } from '../data/site';
import { formatDate, routes, useTranslations, type Lang, tl, pick } from '../i18n/ui';
import { getPricelist, getPricelistUpdated } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';

const items = await getPricelist();
const anySample = items.some((i) => i.data.sample);
const updatedIso = getPricelistUpdated();
const updatedDate = updatedIso ? new Date(`${updatedIso}T12:00:00`) : null;
const updatedText = updatedDate && !isNaN(updatedDate.valueOf()) ? formatDate(updatedDate, lang) : '';

const t = pick(lang, {
  pl: {
      num: 'Scena I · cennik',
      h1a: 'Cennik',
      h1b: 'na żywo',
      intro:
        'Ceny za paczkę <strong>10 sztuk</strong>. Każdy gatunek sprzedaję w jednym wariancie – jako nimfy, mix (nimfy i imago) albo imago. Kliknij nazwę gatunku, żeby zobaczyć jego profil hodowlany. Zamówienie – jednym mailem pod listą.',
      updated: 'cennik zaktualizowany',
      pack: 'Paczka = 10 sztuk wybranego wariantu',
      cart: 'Napisz maila',
      shown: 'widoczne',
      profile: 'Profil hodowlany',
      nophoto: 'brak zdjęcia',
      shipLbl: 'wysyłka, odbiór, płatność',
      shipH: 'Jak podróżują paczki',
      howNum: 'Jak zamówić',
      howH: 'Trzy kroki',
      howHem: 'do paczki',
      steps: [
        ['Wybierz gatunek', 'Z listy powyżej – w profilu hodowlanym znajdziesz cenę i wszystkie informacje o hodowli.'],
        ['Napisz maila', 'Podaj gatunek, liczbę paczek i miejscowość. Przycisk „Napisz w sprawie zamówienia” przygotuje gotową wiadomość.'],
        ['Dostaniesz odpowiedź', 'Potwierdzę dostępność, podam koszt wysyłki i termin. Płatność dopiero po ustaleniu szczegółów.'],
      ],
      wait: 'Gatunku chwilowo brak albo pojawi się wkrótce? Napisz maila – zapiszę Cię na listę oczekujących i dam znać, gdy będzie dostępny.',
      note: 'Ceny w złotych za paczkę 10 szt. · stan hodowli zmienia się z tygodnia na tydzień',
      compare: 'Porównaj gatunki',
      stageH: 'W paczce',
      priceH: 'Cena za 10 szt.',
  },
  en: {
      num: 'Scene I · price list',
      h1a: 'Price list',
      h1b: 'live',
      intro:
        'Prices per pack of <strong>10</strong>. Each species is sold in one form – as nymphs, a mix (nymphs and adults) or adults. Click a species name to see its care sheet. To order, send one e-mail – button below the list.',
      updated: 'price list updated',
      pack: 'Pack = 10 individuals of the chosen option',
      cart: 'Write an e-mail',
      shown: 'shown',
      profile: 'Care sheet',
      nophoto: 'no photo',
      shipLbl: 'shipping, pickup, payment',
      shipH: 'How the parcels travel',
      howNum: 'How to order',
      howH: 'Three steps',
      howHem: 'to a parcel',
      steps: [
        ['Choose a species', 'From the list above – its care sheet shows the price and everything about keeping it.'],
        ['Write an e-mail', 'Give the species, number of packs and your town or country. The “E-mail about an order” button prepares the message for you.'],
        ['Get a reply', 'I will confirm availability, the shipping cost and date. Payment only once everything is agreed.'],
      ],
      wait: 'Species out of stock or coming soon? Send me an e-mail – I will put you on the waiting list and let you know when it is available.',
      note: 'Prices in PLN per pack of 10 · stock changes from week to week',
      compare: 'Compare species',
      stageH: 'In the pack',
      priceH: 'Price per 10',
  },
  de: {
      num: 'Szene I · Preisliste',
      h1a: 'Preisliste',
      h1b: 'aktuell',
      intro:
        'Preise pro Packung mit <strong>10</strong> Tieren. Jede Art wird in einer Form verkauft – als Nymphen, Mix (Nymphen und Adulte) oder Adulte. Euro-Beträge sind Richtwerte. Klicke auf einen Artnamen, um das Haltungsprofil zu sehen. Bestellt wird per E-Mail – Knopf unter der Liste.',
      updated: 'Preisliste aktualisiert',
      pack: 'Packung = 10 Tiere der gewählten Variante',
      cart: 'E-Mail schreiben',
      shown: 'angezeigt',
      profile: 'Haltungsprofil',
      nophoto: 'kein Foto',
      shipLbl: 'Versand, Abholung, Zahlung',
      shipH: 'Wie die Pakete reisen',
      howNum: 'So bestellst du',
      howH: 'Drei Schritte',
      howHem: 'zum Paket',
      steps: [
        ['Art wählen', 'Aus der Liste oben – im Haltungsprofil stehen der Preis und alles zur Haltung.'],
        ['E-Mail schreiben', 'Nenne Art, Anzahl der Packungen und Land bzw. Ort. Der Knopf „Per E-Mail anfragen“ bereitet die Nachricht vor.'],
        ['Antwort erhalten', 'Ich bestätige Verfügbarkeit, Versandkosten und Termin. Bezahlt wird erst, wenn alles geklärt ist.'],
      ],
      wait: 'Art ausverkauft oder bald verfügbar? Schreib mir eine E-Mail – ich trage dich in die Warteliste ein und melde mich, sobald die Art verfügbar ist.',
      note: 'Preise in PLN pro 10er-Packung · der Bestand ändert sich von Woche zu Woche',
      compare: 'Arten vergleichen',
      stageH: 'In der Packung',
      priceH: 'Preis pro 10',
  },
});

---

<Base lang={lang} title={tr('pricelist.title')} description={tr('pricelist.lead')} alt={routes.pricelist[other]} active="pricelist">
  <section class="scene pl-scene">
    <div class="glowspot" style="width:560px;height:560px;right:-160px;top:40px;background:radial-gradient(circle,rgba(232,165,71,.14),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.num}</div>
          <h1 class="h-display">{t.h1a} <em>{t.h1b}</em></h1>
        </div>
        <div class="rv intro" style="--d:.15s">
          <p set:html={t.intro} />
          {updatedText && (
            <p class="upd">
              {t.updated}: <time datetime={updatedIso}>{updatedText}</time>
            </p>
          )}
          {anySample && <p class="draft"><b>{tr('sample.badge')}</b> {tr('sample.note')}</p>}
        </div>
      </div>

      <PriceList lang={lang} />
      <div class="pack-note rv">{t.note}</div>

      <div class={`ship-box rv ${glassSurface}`}>
        <div class="lbl">{t.shipLbl}</div>
        <ul class="ship">
          {tl(site.shipping, lang).map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="scene how-scene">
    <div class="glowspot" style="width:620px;height:620px;left:-220px;top:0;background:radial-gradient(circle,rgba(125,154,87,.14),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.howNum}</div>
          <h2 class="h-display">{t.howH} <em>{t.howHem}</em></h2>
        </div>
        <p class="rv" style="--d:.15s">{tr('contact.orderHint')}</p>
      </div>
      <ol class="steps">
        {
          t.steps.map(([h, p], i) => (
            <li class={`step rv ${glassSurface}`} style={`--d:${i * 0.12}s`}>
              <span class="roman" aria-hidden="true">{['I', 'II', 'III'][i]}</span>
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))
        }
      </ol>
      <p class="waitnote rv" data-glossary>
        <span class="bell" aria-hidden="true">◔</span>
        {t.wait}
      </p>
      <div class="cta rv">
        <a class={buttonVariants()} href={`mailto:${site.contact.email}`}>{t.cart} <span class="arr">→</span></a>
        <a class={buttonVariants({ variant: 'secondary' })} href={routes.compare[lang]}>{t.compare} <span class="arr">→</span></a>
        <a class="link" href={routes.species[lang]}>{tr('nav.species')}</a>
      </div>
    </div>
  </section>
</Base>


<style>
  .pl-scene {
    padding: clamp(120px, 14vw, 170px) 0 clamp(40px, 6vw, 80px);
  }
  .intro :global(strong) {
    color: var(--text);
  }
  .intro .draft {
    margin: 18px 0 0;
  }
  .upd {
    margin: 14px 0 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .upd time {
    color: var(--amber2);
  }

  .pack-note {
    margin-top: 22px;
    color: var(--muted);
    font-size: 13px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .pack-note::before {
    content: '';
    flex: none;
    width: 24px;
    height: 1px;
    background: var(--amber);
  }

  /* wysyłka */
  .ship-box {
    margin-top: 40px;
    padding: clamp(20px, 2.6vw, 32px);
    max-width: 760px;
  }
  .ship-box .lbl {
    margin-bottom: 14px;
  }
  .ship {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: s;
    display: grid;
    gap: 10px;
  }
  .ship li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 8px;
    font-size: 14px;
    color: #d3cfbf;
    line-height: 1.5;
  }
  .ship li::before {
    content: counter(s, upper-roman);
    font-family: var(--serif);
    font-style: italic;
    color: var(--amber);
    font-size: 14px;
  }

  /* jak zamówić */
  .how-scene {
    padding-left: 0;
    padding-right: 0;
    padding-top: clamp(40px, 6vw, 80px);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .step {
    position: relative;
    padding: clamp(22px, 2.6vw, 36px);
    overflow: hidden;
  }
  .roman {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 200;
    font-size: clamp(56px, 6vw, 88px);
    line-height: 0.9;
    color: var(--amber2);
    text-shadow: 0 0 40px rgba(232, 165, 71, 0.4);
    margin-bottom: 18px;
  }
  .step h3 {
    font-size: clamp(24px, 2.2vw, 32px);
    font-style: italic;
    margin-bottom: 10px;
  }
  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .waitnote {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 26px 0 0;
    max-width: 70ch;
    color: #d3cfbf;
    font-size: 15px;
  }
  .bell {
    color: var(--amber);
    font-size: 18px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    align-items: center;
    margin-top: 34px;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
