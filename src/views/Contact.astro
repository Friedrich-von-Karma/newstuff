---
import Base from '../layouts/Base.astro';
import ContactScene from '../components/ContactScene.astro';
import { routes, useTranslations, type Lang, pick } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';
const t = pick(lang, {
  pl: {
      num: 'Blattodea.pl · Kontakt',
      ordersLbl: 'I · zamówienia',
      orders: 'Zamówienia',
      cart: 'Otwórz koszyk',
      idLbl: 'II · oznaczanie',
      id: 'Oznaczanie',
      idGo: 'Oznacz karaczana',
      key: 'Klucz',
  },
  en: {
      num: 'Blattodea.pl · Contact',
      ordersLbl: 'I · orders',
      orders: 'Orders',
      cart: 'Open the cart',
      idLbl: 'II · identification',
      id: 'Identification',
      idGo: 'Identify a cockroach',
      key: 'Key',
  },
  de: {
      num: 'Blattodea.pl · Kontakt',
      ordersLbl: 'I · Bestellungen',
      orders: 'Bestellungen',
      cart: 'Warenkorb öffnen',
      idLbl: 'II · Bestimmung',
      id: 'Bestimmung',
      idGo: 'Schabe bestimmen lassen',
      key: 'Schlüssel',
  },
});
---

<Base lang={lang} title={tr('contact.title')} description={tr('contact.lead')} alt={routes.contact[other]} active="contact">
  <ContactScene lang={lang} level="h1" num={t.num} id="contact" />

  <section class="wrap hints" aria-label={pick(lang, { pl: 'Wskazówki', en: 'Tips', de: 'Hinweise' })}>
    <article class="hint rv">
      <div class="lbl">{t.ordersLbl}</div>
      <h2>{t.orders}</h2>
      <p>{tr('contact.orderHint')}</p>
      <div class="acts">
        <button type="button" class="btn" data-open-cart>{t.cart} <span class="arr">→</span></button>
        <a class="btn quiet" href={routes.pricelist[lang]}>{tr('nav.pricelist')} <span class="arr">→</span></a>
      </div>
    </article>
    <article class="hint rv" style="--d:.12s">
      <div class="lbl">{t.idLbl}</div>
      <h2>{t.id}</h2>
      <p data-glossary>{tr('contact.idHint')}</p>
      <div class="acts">
        <a class="btn" href={routes.identify[lang]}>{t.idGo} <span class="arr">→</span></a>
        <a class="btn quiet" href={routes.key[lang]}>{t.key} <span class="arr">→</span></a>
      </div>
    </article>
  </section>
</Base>

<style>
  .hints {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(70px, 10vw, 130px);
  }
  .hint {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 44px);
    border: 1px solid var(--line);
    border-radius: 4px;
    background: linear-gradient(160deg, var(--bg3), var(--bg2));
    transition:
      border-color 0.5s,
      box-shadow 0.7s;
  }
  .hint::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 110%;
    aspect-ratio: 1;
    right: -50%;
    bottom: -70%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 165, 71, 0.15), transparent 60%);
    animation: breathe 7s ease-in-out infinite;
    pointer-events: none;
  }
  .hint + .hint::before {
    background: radial-gradient(circle, rgba(125, 154, 87, 0.2), transparent 60%);
    animation-delay: -3s;
  }
  .hint:hover {
    border-color: rgba(232, 165, 71, 0.45);
    box-shadow: 0 30px 80px -30px rgba(232, 165, 71, 0.25);
  }
  h2 {
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 300;
    font-style: italic;
  }
  p {
    color: #d3cfbf;
    margin: 0;
    max-width: 52ch;
    flex: 1;
  }
  .acts {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  @media (max-width: 760px) {
    .hints {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
