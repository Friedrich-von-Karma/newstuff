---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, routes, useTranslations, type Lang } from '../i18n/ui';
import { hasTranslation, postSlug, slugify, type Post } from '../lib/content';

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const { Content } = await render(post);
const slug = postSlug(post);
const alt = (await hasTranslation(post, other)) ? `${routes.blog[other]}${slug}/` : routes.blog[other];
const d = post.data;
---

<Base lang={lang} title={d.title} description={d.description} alt={alt} active="blog" image={d.cover}>
  <article class="wrap post">
    <p class="crumbs"><a href={routes.blog[lang]}>← {tr('blog.back')}</a></p>
    <header>
      <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <ul class="tags">
        {
          d.tags.map((t) => (
            <li>
              <a href={`${routes.blog[lang]}tag/${slugify(t)}/`}>#{t}</a>
            </li>
          ))
        }
      </ul>
    </header>
    {d.cover && <img class="cover" src={d.cover} alt={d.coverAlt ?? ''} />}
    <div class="prose">
      <Content />
    </div>
    <p class="end caps" aria-hidden="true">— finis —</p>
  </article>
</Base>

<style>
  .post {
    max-width: calc(var(--measure) + 64px);
  }
  .crumbs {
    padding-top: 1.5rem;
    font-size: 0.85rem;
    font-family: var(--f-type);
  }
  header {
    text-align: center;
    padding: 1.5rem 0 2rem;
    margin-bottom: 2.5rem;
    border-top: 3px double var(--brass-dark);
    border-bottom: 1px solid var(--rule);
  }
  time {
    font-family: var(--f-type);
    font-size: 0.85rem;
    color: var(--stamp-red);
  }
  h1 {
    margin: 0.5rem 0;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    font-style: italic;
  }
  header .tags {
    justify-content: center;
  }
  .cover {
    width: 100%;
    margin-bottom: 2.5rem;
    border: 10px solid #fbf8ef;
    box-shadow: 0 20px 30px -20px rgba(0, 0, 0, 0.6);
  }
  .prose {
    font-size: 1.1rem;
    margin: 0 auto;
  }
  .prose :global(> p:first-of-type::first-letter) {
    float: left;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 4.6rem;
    line-height: 0.8;
    padding: 0.4rem 0.55rem 0 0;
    color: var(--wood-600);
  }
  .end {
    text-align: center;
    margin-top: 3rem;
    color: var(--brass-dark);
    letter-spacing: 0.3em;
  }
</style>
