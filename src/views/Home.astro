---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import PackPicker from '../components/PackPicker.astro';
import ContactScene from '../components/ContactScene.astro';
import { routes, useTranslations, localeOf, type Lang, type UiKey } from '../i18n/ui';
import { getPosts, getSpecies, getPricelist, getPricelistUpdated, getSpeciesNote, getObservations, postSlug, slugify } from '../lib/content';
import { taxa, characters } from '../data/key';
import { photos, photoSrc, photoPage } from '../data/photos';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';
const L = (p: string) => routes[p as keyof typeof routes][lang];

const [posts, species, pricelist, observations] = await Promise.all([getPosts(lang), getSpecies(), getPricelist(), getObservations()]);
const updated = getPricelistUpdated();
const orderable = pricelist.filter((p) => p.data.status === 'available' || p.data.status === 'low');
const anySample = pricelist.some((p) => p.data.sample) || species.some((s) => s.data.sample);

// opisy własne do profili
const notes = await Promise.all(
  species.map(async (s) => {
    const n = await getSpeciesNote(s.id, lang);
    return n ? (await render(n)).Content : null;
  }),
);

/** odmiana liczebników: 1 gatunek, 2 gatunki, 5 gatunków */
function plural(n: number, one: string, few: string, many: string) {
  if (!pl) return n === 1 ? one : few;
  if (n === 1) return one;
  const d = n % 10;
  const dd = n % 100;
  return d >= 2 && d <= 4 && (dd < 12 || dd > 14) ? few : many;
}
const pad = (n: number) => String(n).padStart(2, '0');
function splitDate(d: Date) {
  const s = d.toLocaleDateString(localeOf(lang), { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const i = s.indexOf(' ');
  return { day: String(d.getUTCDate()), rest: s.slice(i + 1) };
}
const upd = updated ? splitDate(new Date(`${updated}T00:00:00Z`)) : null;

const credit = (id: string) => {
  const p = photos[id];
  if (!p) return null;
  return { author: p.author, license: p.license, licenseUrl: p.licenseUrl, page: photoPage(p) };
};
const img = (id: string, w: 330 | 500 | 960 | 1280 = 960) => (photos[id] ? photoSrc(photos[id], w) : null);

// układ kafli w cenniku (powtarza rytm wzorca)
const sizes = ['big', 'wide', 'one'];
const bento = pricelist.map((item, i) => ({ item, size: sizes[i] ?? 'wide', photoId: item.data.profile ?? item.id }));
const dateAfter = Math.min(2, bento.length - 1);

const native = taxa.filter((x) => x.status === 'native').length;
const latest = posts[0];
const latestDate = latest ? splitDate(latest.data.date) : null;

const t = pl
  ? {
      scene: 'Scena',
      heroAlt: 'Macropanesthia rhinoceros – największy karaczan świata',
      readTop: 'w cenniku',
      readSpecies: plural(pricelist.length, 'gatunek', 'gatunki', 'gatunków'),
      readBottom: `${orderable.length} do zamówienia · ${taxa.length} w kluczu`,
      cue: 'Zejdź w ściółkę',
      priceH: ['Cennik', 'na żywo'],
      priceP: 'Każdy gatunek w paczkach po 10 sztuk – zależnie od gatunku są to nimfy, mix (nimfy i imago) albo imago. Dodaj do koszyka albo zamów od razu mailem. Przy braku towaru zapisz się na powiadomienie.',
      updatedLbl: 'cennik zaktualizowany',
      packNote: 'Paczka = 10 sztuk',
      shipLbl: 'wysyłka, odbiór, płatność',
      shipH: 'Jak podróżują paczki',
      fullPrice: 'Pełny cennik',
      priceNote: 'Ceny w złotych za paczkę 10 szt.',
      profileH: ['Profile', 'hodowlane'],
      profileP: 'Parametry hodowli: temperatura, wilgotność, podłoże, karmienie i tempo rozwoju. Przewiń w bok, przeciągnij albo użyj strzałek.',
      reel: 'Karuzela profili hodowlanych',
      prev: 'Poprzedni profil',
      next: 'Następny profil',
      full: 'Pełny profil',
      endNum: 'Dalej w ciemności…',
      endH: 'Porównaj i obejrzyj',
      endP: 'Zestaw parametry gatunków obok siebie albo zajrzyj do galerii zdjęć i filmów z hodowli.',
      compare: 'Porównywarka',
      gallery: 'Galeria',
      quote: ['Nie każdy karaczan mieszka w kuchni. W polskich lasach, pod ', 'ściółką', ', żyją drobne, rodzime gatunki – warto umieć je rozpoznać.'],
      quoteAlt: 'Zadomka leśna (Ectobius sylvestris) – samica z ooteką',
      keyH: ['Klucz', 'i teren'],
      keyP: 'Znalazłeś karaczana w lesie, na łące albo w mieszkaniu? Zaznacz widoczne cechy w kluczu, wyślij zdjęcie do oznaczenia albo sprawdź, gdzie w Polsce potwierdzono obserwacje.',
      draft: 'Wersja robocza',
      draftTxt: 'dane i cechy klucza wymagają jeszcze weryfikacji',
      keyTile: 'Klucz do karaczanów Polski',
      keySub: `${characters.length} ${plural(characters.length, 'cecha', 'cechy', 'cech')} do zaznaczenia · ${native} ${plural(native, 'gatunek rodzimy', 'gatunki rodzime', 'gatunków rodzimych')}`,
      keyNum: plural(taxa.length, 'gatunek', 'gatunki', 'gatunków'),
      idTile: 'Oznacz mojego karaczana',
      idSub: 'Prześlij zdjęcie i opis znaleziska do oznaczenia.',
      idNum: 'zdjęcie + opis',
      mapTile: 'Mapa obserwacji',
      mapNum: plural(observations.length, 'obserwacja', 'obserwacje', 'obserwacji'),
      mapSub: observations.length ? 'Zweryfikowane stanowiska karaczanów w Polsce.' : 'Mapa czeka na pierwsze zweryfikowane zgłoszenia.',
      open: 'Otwórz',
      blogH: ['Notatki', 'z hodowli i terenu'],
      blogP: tr('blog.lead'),
      postLbl: 'wpis z dnia',
      readPost: 'Czytaj wpis',
      allPosts: tr('home.all'),
      contactNum: 'Scena VI · Kontakt',
    }
  : {
      scene: 'Scene',
      heroAlt: 'Macropanesthia rhinoceros – the heaviest cockroach in the world',
      readTop: 'in the price list',
      readSpecies: plural(pricelist.length, 'species', 'species', 'species'),
      readBottom: `${orderable.length} to order · ${taxa.length} in the key`,
      cue: 'Down into the leaf litter',
      priceH: ['Price list', 'live'],
      priceP: 'Every species comes in packs of 10 – nymphs, a mix (nymphs and adults) or adults, depending on the species. Add it to the cart or order straight away by e-mail. If something is out of stock, sign up for a notification.',
      updatedLbl: 'price list updated',
      packNote: 'One pack = 10 individuals',
      shipLbl: 'shipping, pickup, payment',
      shipH: 'How the parcels travel',
      fullPrice: 'Full price list',
      priceNote: 'Prices in PLN per pack of 10.',
      profileH: ['Care', 'sheets'],
      profileP: 'Keeping parameters: temperature, humidity, substrate, diet and development time. Scroll sideways, drag or use the arrows.',
      reel: 'Care sheet carousel',
      prev: 'Previous sheet',
      next: 'Next sheet',
      full: 'Full care sheet',
      endNum: 'Further into the dark…',
      endH: 'Compare and browse',
      endP: 'Put the species side by side, or have a look at the gallery of photos and videos from the breeding room.',
      compare: 'Compare',
      gallery: 'Gallery',
      quote: ['Not every cockroach lives in a kitchen. In Polish woodland, under the ', 'leaf litter', ', live small native species – they are worth learning to recognise.'],
      quoteAlt: 'Forest cockroach (Ectobius sylvestris) – female with ootheca',
      keyH: ['Key', 'and field'],
      keyP: 'Found a cockroach in a forest, a meadow or a flat? Tick the visible features in the key, send a photo for identification or see where in Poland records have been confirmed.',
      draft: 'Draft',
      draftTxt: 'the key data and features still need verification',
      keyTile: 'Key to the cockroaches of Poland',
      keySub: `${characters.length} features to tick · ${native} native species`,
      keyNum: 'species',
      idTile: 'Identify my cockroach',
      idSub: 'Send a photo and a short description of your find for identification.',
      idNum: 'photo + notes',
      mapTile: 'Records map',
      mapNum: observations.length === 1 ? 'record' : 'records',
      mapSub: observations.length ? 'Verified cockroach records from Poland.' : 'The map is waiting for its first verified records.',
      open: 'Open',
      blogH: ['Notes', 'from breeding and the field'],
      blogP: tr('blog.lead'),
      postLbl: 'posted on',
      readPost: 'Read the post',
      allPosts: tr('home.all'),
      contactNum: 'Scene VI · Contact',
    };
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const heroPhoto = 'macropanesthia-rhinoceros';
const interPhoto = 'ectobius-sylvestris';
const keyTiles = [
  { href: L('key'), title: t.keyTile, big: String(taxa.length), unit: t.keyNum, sub: t.keySub, photo: 'ectobius-lapponicus' },
  { href: L('identify'), title: t.idTile, big: '?', unit: t.idNum, sub: t.idSub, photo: 'blattella-germanica' },
  { href: L('map'), title: t.mapTile, big: String(observations.length), unit: t.mapNum, sub: t.mapSub, photo: 'ectobius-pallidus' },
];
const diffLabel = (d: number) => tr(`species.difficulty.${d}` as UiKey);
---

<Base lang={lang} alt={routes.home[other]} active="home">
  <!-- ============ SCENA I – HERO ============ -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-media" data-hero-media>
      {img(heroPhoto, 1280) && <img src={img(heroPhoto, 1280)} alt={t.heroAlt} loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" />}
    </div>
    {
      credit(heroPhoto) && (
        <div class="credit hero-credit">
          {t.heroAlt}. {pl ? 'Fot.' : 'Photo:'} {credit(heroPhoto)!.author} ·{' '}
          <a href={credit(heroPhoto)!.licenseUrl} target="_blank" rel="noopener license">
            {credit(heroPhoto)!.license}
          </a>{' '}
          ·{' '}
          <a href={credit(heroPhoto)!.page} target="_blank" rel="noopener">
            Wikimedia Commons
          </a>
        </div>
      )
    }
    <div class="hero-in">
      <div>
        <div class="kicker">Blattodea.pl · {t.scene} I</div>
        <h1 id="hero-h">
          {
            pl ? (
              <>
                <span class="ln"><span style="--d:.15s">Hodowla</span></span>
                <span class="ln"><span style="--d:.3s">karaczanów</span></span>
                <span class="ln"><span style="--d:.45s">z <em>Pasji</em></span></span>
              </>
            ) : (
              <>
                <span class="ln"><span style="--d:.15s">Cockroaches</span></span>
                <span class="ln"><span style="--d:.3s">bred with</span></span>
                <span class="ln"><span style="--d:.45s"><em>Passion</em></span></span>
              </>
            )
          }
        </h1>
        <p class="lead rv" style="--d:.7s">{tr('home.lead')}</p>
      </div>
      <div class="hero-side rv" style="--d:.9s">
        <a class="readout" href={L('pricelist')}>
          {t.readTop}
          <b>{pricelist.length} {t.readSpecies}</b>
          {t.readBottom}
        </a>
        <a class="cue" href="#s-pricelist"><i></i>{t.cue}</a>
      </div>
    </div>
  </section>

  <!-- ============ SCENA II – CENNIK ============ -->
  <section class="scene" id="s-pricelist" aria-labelledby="s-pricelist-h">
    <div class="glowspot" style="width:520px;height:520px;right:-140px;top:60px;background:radial-gradient(circle,rgba(232,165,71,.13),transparent 65%)"></div>
    <div class="scene-head">
      <div class="rv">
        <div class="num">{t.scene} II</div>
        <h2 class="h-display" id="s-pricelist-h">{t.priceH[0]} <em>{t.priceH[1]}</em></h2>
      </div>
      <p class="rv" style="--d:.15s">{t.priceP}</p>
    </div>

    <div class="bento">
      {
        bento.map(({ item, size, photoId }, i) => {
          const src = img(photoId, size === 'one' ? 500 : 960);
          const cr = credit(photoId);
          return (
            <>
              <article class:list={['tile', 'rv', `t-${size}`]} style={`--d:${(i * 0.08).toFixed(2)}s`}>
                <div class="sp-img">{src ? <img src={src} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" /> : <span class="nophoto"><b>{pl ? 'brak zdjęcia' : 'no photo'}</b></span>}</div>
                <div class="tile-body">
                  <div>
                    <span class={`status st-${item.data.status}`}>{tr(`status.${item.data.status}` as UiKey)}</span>
                  </div>
                  <div>
                    <h3 class="sp-name">
                      {item.data.profile ? <a href={`${L('species')}${item.data.profile}/`}>{item.data.latin}</a> : item.data.latin}
                    </h3>
                    {(() => {
                      const sp = species.find((s) => s.id === item.data.profile);
                      return sp?.data.commonName ? <div class="sp-common">{sp.data.commonName[lang]}</div> : null;
                    })()}
                    {item.data.note && <div class="sp-note" data-glossary>{item.data.note[lang]}</div>}
                  </div>
                  <PackPicker item={item} lang={lang} big={size === 'big'} />
                  {cr && (
                    <div class="credit">
                      {pl ? 'Fot.' : 'Photo:'} {cr.author} ·{' '}
                      <a href={cr.licenseUrl} target="_blank" rel="noopener license">
                        {cr.license}
                      </a>{' '}
                      ·{' '}
                      <a href={cr.page} target="_blank" rel="noopener">
                        Wikimedia Commons
                      </a>
                    </div>
                  )}
                </div>
              </article>
              {i === dateAfter && upd && (
                <article class="tile rv t-date" style="--d:.2s">
                  <div class="tile-body">
                    <div class="lbl">{t.updatedLbl}</div>
                    <div>
                      <time class="bigdate" datetime={updated}>{upd.day}</time>
                      <div class="date-rest">{upd.rest}</div>
                    </div>
                    <div class="credit">{t.packNote}</div>
                  </div>
                </article>
              )}
            </>
          );
        })
      }
      <article class="tile rv t-ship" style="--d:.1s">
        <div class="tile-body">
          <div class="lbl">{t.shipLbl}</div>
          <h3>{t.shipH}</h3>
          <ul class="ship" data-glossary>
            {site.shipping[lang].map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </article>
    </div>
    <div class="scene-foot rv">
      <span class="pack-note">{t.priceNote}{anySample && <> · {tr('sample.note')}</>}</span>
      <a class="btn ghost" href={L('pricelist')}>{t.fullPrice} <span class="arr">→</span></a>
    </div>
  </section>

  <!-- ============ SCENA III – PROFILE ============ -->
  <section class="scene profiles" id="s-species" aria-labelledby="s-species-h">
    <div class="glowspot" style="width:640px;height:640px;left:-220px;top:40px;background:radial-gradient(circle,rgba(125,154,87,.15),transparent 65%)"></div>
    <div class="scene-head">
      <div class="rv">
        <div class="num">{t.scene} III</div>
        <h2 class="h-display" id="s-species-h">{t.profileH[0]} <em>{t.profileH[1]}</em></h2>
      </div>
      <p class="rv" style="--d:.15s">{t.profileP}</p>
    </div>
    <div class="reel-wrap rv" data-reel-wrap>
      <div class="reel" data-reel tabindex="0" role="region" aria-label={t.reel}>
        {
          species.map((s, i) => {
            const d = s.data;
            const src = img(s.id, 960);
            const cr = credit(s.id);
            const Note = notes[i];
            return (
              <article class="card" data-card>
                <div class="card-photo">
                  {src ? (
                    <img src={src} alt={`${d.latin}${d.commonName ? ` – ${d.commonName[lang]}` : ''}`} loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" onerror="this.style.opacity=0" />
                  ) : (
                    <span class="nophoto">
                      <b>{pl ? 'brak zdjęcia' : 'no photo'}</b>
                    </span>
                  )}
                  <div class="idx" aria-hidden="true">{pad(i + 1)}</div>
                  {cr && (
                    <div class="credit">
                      {pl ? 'Fot.' : 'Photo:'} {cr.author} ·{' '}
                      <a href={cr.licenseUrl} target="_blank" rel="noopener license">
                        {cr.license}
                      </a>{' '}
                      ·{' '}
                      <a href={cr.page} target="_blank" rel="noopener">
                        Wikimedia Commons
                      </a>
                    </div>
                  )}
                </div>
                <div class="card-txt">
                  <div>
                    <h3>{d.latin}</h3>
                    <div class="card-sub">
                      {d.commonName && <b>{d.commonName[lang]}</b>}
                      {d.commonName && ' · '}
                      {d.author && <>{d.author} · </>}
                      {d.family}
                    </div>
                  </div>
                  <dl class="params">
                    <div>
                      <dt>{tr('species.temperature')}</dt>
                      <dd class="big">{d.temperature}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.size')}</dt>
                      <dd class="big">{d.size[lang]}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.humidity')}</dt>
                      <dd>{d.humidity[lang]}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.origin')}</dt>
                      <dd>{d.origin[lang]}</dd>
                    </div>
                    <div class="wide">
                      <dt>{tr('species.substrate')}</dt>
                      <dd>{d.substrate[lang]}</dd>
                    </div>
                    <div class="wide">
                      <dt>{tr('species.food')}</dt>
                      <dd>{d.food[lang]}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.reproduction')}</dt>
                      <dd data-glossary>{d.reproduction[lang]}</dd>
                    </div>
                    <div>
                      <dt>{tr('species.development')}</dt>
                      <dd>{d.development[lang]}</dd>
                    </div>
                  </dl>
                  <div class="flags">
                    <span>
                      <span class="diff" aria-hidden="true">
                        {[1, 2, 3].map((k) => <i class:list={{ on: k <= d.difficulty }} />)}
                      </span>
                      {tr('species.difficulty')}: <b>{diffLabel(d.difficulty)}</b>
                    </span>
                    <span>
                      {tr('species.climbs')}: <b>{d.climbs ? tr('species.yes') : tr('species.no')}</b>
                    </span>
                    <span>
                      {tr('species.flies')}: <b>{d.flies ? tr('species.yes') : tr('species.no')}</b>
                    </span>
                  </div>
                  {Note && (
                    <div class="own" data-glossary>
                      <Note />
                    </div>
                  )}
                  <a class="btn ghost full" href={`${L('species')}${s.id}/`}>
                    {t.full} <span class="arr">→</span>
                  </a>
                </div>
              </article>
            );
          })
        }
        <div class="card-end" data-card>
          <div class="num">{t.endNum}</div>
          <h3>{t.endH}</h3>
          <p>{t.endP}</p>
          <div class="end-links">
            <a class="btn ghost" href={L('compare')}>{t.compare} <span class="arr">→</span></a>
            <a class="btn quiet" href={L('gallery')}>{t.gallery} <span class="arr">→</span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="reel-ctrl">
      <button type="button" class="rbtn" data-prev aria-label={t.prev}>←</button>
      <button type="button" class="rbtn" data-next aria-label={t.next}>→</button>
      <div class="track" aria-hidden="true"><i data-bar></i></div>
      <div class="reel-count" aria-hidden="true"><b data-cur>01</b> / <span>{pad(species.length + 1)}</span></div>
    </div>
  </section>

  <!-- ============ przerywnik ============ -->
  <section class="interlude" aria-label={pl ? 'Przerywnik' : 'Interlude'}>
    <div class="bgimg" data-par="0.18">
      {img(interPhoto, 1280) && <img src={img(interPhoto, 1280)} alt={t.quoteAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" />}
    </div>
    <blockquote class="rv">
      <p>{t.quote[0]}<em>{t.quote[1]}</em>{t.quote[2]}</p>
      <footer><i>Ectobius sylvestris</i> · {t.scene} IV</footer>
    </blockquote>
    {
      credit(interPhoto) && (
        <div class="credit">
          {t.quoteAlt}. {pl ? 'Fot.' : 'Photo:'} {credit(interPhoto)!.author} ·{' '}
          <a href={credit(interPhoto)!.licenseUrl} target="_blank" rel="noopener license">
            {credit(interPhoto)!.license}
          </a>{' '}
          ·{' '}
          <a href={credit(interPhoto)!.page} target="_blank" rel="noopener">
            Wikimedia Commons
          </a>
        </div>
      )
    }
  </section>

  <!-- ============ SCENA IV – KLUCZ I TEREN ============ -->
  <section class="scene" id="s-key" aria-labelledby="s-key-h">
    <div class="glowspot" style="width:560px;height:560px;right:-160px;bottom:0;background:radial-gradient(circle,rgba(125,154,87,.13),transparent 65%)"></div>
    <div class="scene-head">
      <div class="rv">
        <div class="num">{t.scene} IV</div>
        <h2 class="h-display" id="s-key-h">{t.keyH[0]} <em>{t.keyH[1]}</em></h2>
        <div class="draft"><b>{t.draft}</b> {t.draftTxt}</div>
      </div>
      <p class="rv" style="--d:.15s">{t.keyP}</p>
    </div>
    <div class="field-tiles">
      {
        keyTiles.map((k, i) => {
          const src = img(k.photo, 500);
          const cr = credit(k.photo);
          return (
            <div class="ftile rv" style={`--d:${(i * 0.1).toFixed(1)}s`}>
              <div class="sp-img">{src && <img src={src} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity=0" />}</div>
              <a class="ftile-link" href={k.href}>
                <span class="ftile-n">{roman[i]}</span>
                <span class="ftile-big">
                  <b>{k.big}</b>
                  <small>{k.unit}</small>
                </span>
                <span class="ftile-title">{k.title}</span>
                <span class="ftile-sub">{k.sub}</span>
                <span class="ftile-go">
                  {t.open} <span class="arr">→</span>
                </span>
              </a>
              {cr && (
                <div class="credit">
                  <i>{taxa.find((x) => x.id === k.photo)?.latin}</i> · {pl ? 'Fot.' : 'Photo:'} {cr.author} ·{' '}
                  <a href={cr.licenseUrl} target="_blank" rel="noopener license">
                    {cr.license}
                  </a>{' '}
                  ·{' '}
