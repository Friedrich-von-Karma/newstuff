<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hero: zdjęcie przesuwa się wolniej niż strona.
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  if (media && !reduce) {
    let ticking = false;
    const run = () => {
      ticking = false;
      const y = window.scrollY;
      if (y < window.innerHeight * 1.2) media.style.transform = `translate3d(0,${(y * 0.35).toFixed(1)}px,0)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(run);
        }
      },
      { passive: true },
    );
    run();
  }

  // Karuzela profili: przyciąganie, strzałki, pasek postępu, przeciąganie myszą.
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  if (reel) {
    const cards = Array.from(reel.querySelectorAll<HTMLElement>('[data-card]'));
    const prev = document.querySelector<HTMLButtonElement>('[data-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-next]');
    const bar = document.querySelector<HTMLElement>('[data-bar]');
    const cur = document.querySelector<HTMLElement>('[data-cur]');
    const padL = () => parseFloat(getComputedStyle(reel).paddingLeft) || 0;
    const nearest = () => {
      const l = reel.getBoundingClientRect().left + padL();
      let best = 0;
      let bd = Infinity;
      cards.forEach((c, k) => {
        const d = Math.abs(c.getBoundingClientRect().left - l);
        if (d < bd) {
          bd = d;
          best = k;
        }
      });
      // na końcu przewijania aktywna jest ostatnia karta
      if (reel.scrollLeft >= reel.scrollWidth - reel.clientWidth - 8) best = cards.length - 1;
      return best;
    };
    const setCur = (i: number) => {
      cards.forEach((c, k) => c.classList.toggle('cur', k === i));
      if (cur) cur.textContent = String(i + 1).padStart(2, '0');
      if (bar) {
        bar.style.width = `${100 / cards.length}%`;
        bar.style.transform = `translateX(${i * 100}%)`;
      }
      if (prev) prev.disabled = reel.scrollLeft < 8;
      if (next) next.disabled = reel.scrollLeft >= reel.scrollWidth - reel.clientWidth - 8;
    };
    const go = (dir: number) => {
      const i = Math.max(0, Math.min(cards.length - 1, nearest() + dir));
      reel.scrollTo({ left: cards[i].offsetLeft - padL(), behavior: reduce ? 'auto' : 'smooth' });
    };
    let st = 0;
    reel.addEventListener(
      'scroll',
      () => {
        clearTimeout(st);
        st = window.setTimeout(() => setCur(nearest()), 60);
      },
      { passive: true },
    );
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    reel.addEventListener('keydown', (e) => {
      if (e.target !== reel) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
    });
    // przeciąganie myszą (dotyk przewija natywnie)
    let down = false;
    let moved = false;
    let sx = 0;
    let sl = 0;
    reel.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      if ((e.target as HTMLElement).closest('a,button,input,label')) return;
      down = true;
      moved = false;
      sx = e.clientX;
      sl = reel.scrollLeft;
      reel.classList.add('drag');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 4) moved = true;
      reel.scrollLeft = sl - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!down) return;
      down = false;
      reel.classList.remove('drag');
      if (moved) go(0);
    });
    reel.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );
    window.addEventListener('resize', () => setCur(nearest()));
    setCur(0);
    reel.classList.add('ready');
  }
</script>

