---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CommonsPhoto from '../components/CommonsPhoto.astro';
import PackPicker from '../components/PackPicker.astro';
import { formatDate, routes, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { getGallery, getPriceForProfile, getSpecies, getSpeciesNote } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'species'>;
}
const { lang, entry } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';
const d = entry.data;

const [price, note, breeding, all] = await Promise.all([
  getPriceForProfile(entry.id),
  getSpeciesNote(entry.id, lang),
  getGallery(entry.id),
  getSpecies(),
]);
const Note = note ? (await render(note)).Content : null;
const idx = all.findIndex((s) => s.id === entry.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : undefined;
const own = d.gallery;
const description = `${d.latin}${d.commonName ? ` (${d.commonName[lang]})` : ''} – ${tr('species.card').toLowerCase()}: ${d.temperature}, ${d.humidity[lang]}, ${d.food[lang]}.`;
const sexPhotos = {
  male: breeding.find((g) => g.data.stage === 'male' && g.data.src),
  female: breeding.find((g) => g.data.stage === 'female' && g.data.src),
};
const tx = d.taxonomy;
const hasMore = !!(tx || d.sexing || d.stages || d.problems.length || d.remark);
const ytEmbed = (id: string) => `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;

const t = pl
  ? {
      noteH: 'Opis z hodowli',
      buyLbl: 'w cenniku · paczka 10 szt.',
      breedNum: 'Z mojej hodowli',
      breedH: 'Zdjęcia',
      breedHem: 'i filmy',
      breedP: `Ujęcia ${d.latin} z mojej hodowli. Kliknij zdjęcie, żeby je powiększyć.`,
      breedEmpty: 'Zdjęcia i filmy tego gatunku pojawią się tutaj.',
      slotPhoto: 'miejsce na Twoje zdjęcie',
      slotVideo: 'miejsce na Twój film',
      video: 'film',
      photo: 'zdjęcie',
      fullGallery: 'Pełna galeria',
      compare: 'Porównaj z innym gatunkiem',
      next: 'Następny profil',
      close: 'Zamknij',
      zoom: 'Powiększ zdjęcie',
      climbs: 'wspina się po szkle',
      flies: 'lata',
      moreNum: 'Więcej o gatunku',
      moreH: 'Płeć, stadia',
      moreHem: 'i pułapki',
      taxH: 'Taksonomia',
      order: 'Rząd',
      family: 'Rodzina',
      subfamily: 'Podrodzina',
      tribe: 'Plemię',
      synonyms: 'Synonimy',
      trade: 'Nazwy w handlu',
      csf: 'Cockroach Species File',
      sexH: 'Jak rozpoznać płeć',
      adults: 'Dorosłe',
      nymphs: 'Nimfy',
      male: 'samiec',
      female: 'samica',
      sexSlot: 'zdjęcie pojawi się tutaj',
      stagesH: 'Stadia rozwoju',
      problemsH: 'Typowe problemy',
      remarkH: 'Warto wiedzieć',
    }
  : {
      noteH: 'Breeding notes',
      buyLbl: 'in the price list · pack of 10',
      breedNum: 'From my breeding room',
      breedH: 'Photos',
      breedHem: 'and videos',
      breedP: `Shots of ${d.latin} from my breeding room. Click a photo to enlarge it.`,
      breedEmpty: 'Photos and videos of this species will appear here.',
      slotPhoto: 'a place for your photo',
      slotVideo: 'a place for your video',
      video: 'video',
      photo: 'photo',
      fullGallery: 'Full gallery',
      compare: 'Compare with another species',
      next: 'Next care sheet',
      close: 'Close',
      zoom: 'Enlarge photo',
      climbs: 'climbs glass',
      flies: 'flies',
      moreNum: 'More about the species',
      moreH: 'Sexes, stages',
      moreHem: 'and pitfalls',
      taxH: 'Taxonomy',
      order: 'Order',
      family: 'Family',
      subfamily: 'Subfamily',
      tribe: 'Tribe',
      synonyms: 'Synonyms',
      trade: 'Trade names',
      csf: 'Cockroach Species File',
      sexH: 'How to sex them',
      adults: 'Adults',
      nymphs: 'Nymphs',
      male: 'male',
      female: 'female',
      sexSlot: 'photo coming soon',
      stagesH: 'Life stages',
      problemsH: 'Common problems',
      remarkH: 'Good to know',
    };
---

<Base lang={lang} title={d.latin} description={description} alt={`${routes.species[other]}${entry.id}/`} active="species" image={own[0]?.src} jsonld={[{ '@type': 'Taxon', name: d.latin, taxonRank: 'species', ...(d.author ? { scientificNameAuthorship: d.author } : {}), parentTaxon: { '@type': 'Taxon', name: d.family, taxonRank: 'family' }, url: new URL(`${routes.species[lang]}${entry.id}/`, Astro.site).href }]}>
  <article class="sp">
    <div class="glowspot" style="width:700px;height:700px;right:-240px;top:-80px;background:radial-gradient(circle,rgba(232,165,71,.14),transparent 65%)"></div>
    <div class="wrap">
      <p class="crumbs rv">
        <a href={routes.species[lang]}>← {tr('species.back')}</a>
      </p>

      <div class="full panel rv" style="--d:.1s">
        <div class="photo">
          <div class="stick">
          {
            own.length > 0 ? (
              <button type="button" class="mainph zoom" data-src={own[0].src} data-cap={own[0].caption?.[lang] ?? own[0].alt[lang]} aria-label={t.zoom}>
                <img src={own[0].src} alt={own[0].alt[lang]} loading="eager" />
              </button>
            ) : (
              <CommonsPhoto id={entry.id} lang={lang} alt={`${d.latin}${d.commonName ? ` – ${d.commonName[lang]}` : ''}`} width={1280} eager class="commons" />
            )
          }
          <span class="idx" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
          </div>
          {
            own.length > 1 && (
              <ul class="thumbs">
                {own.slice(1).map((g) => (
                  <li>
                    <button type="button" class="zoom" data-src={g.src} data-cap={g.caption?.[lang] ?? g.alt[lang]} aria-label={t.zoom}>
                      <img src={g.src} alt={g.alt[lang]} loading="lazy" />
                    </button>
                  </li>
                ))}
              </ul>
            )
          }
          {own[0]?.caption && <p class="credit owncap">{own[0].caption[lang]}</p>}
        </div>

        <div class="txt">
          <header>
            <div class="kicker">{d.family}</div>
            <h1 class="latin">{d.latin}</h1>
            <div class="sub">
              {d.commonName && <b>{d.commonName[lang]}</b>}
              {d.author && <span> · {d.author}</span>}
              <span> · {d.family}</span>
            </div>
            {d.sample && <p class="draft"><b>{tr('sample.badge')}</b> {tr('sample.note')}</p>}
          </header>

          <dl class="params" data-glossary>
            <div>
              <dt>{tr('species.temperature')}</dt>
              <dd class="big">{d.temperature}</dd>
            </div>
            <div>
              <dt>{tr('species.size')}</dt>
              <dd class="big">{d.size[lang]}</dd>
            </div>
            <div>
              <dt>{tr('species.humidity')}</dt>
              <dd>{d.humidity[lang]}</dd>
            </div>
            <div>
              <dt>{tr('species.origin')}</dt>
              <dd>{d.origin[lang]}</dd>
            </div>
            <div class="wide">
              <dt>{tr('species.substrate')}</dt>
              <dd>{d.substrate[lang]}</dd>
            </div>
            <div class="wide">
              <dt>{tr('species.food')}</dt>
              <dd>{d.food[lang]}</dd>
            </div>
            <div>
              <dt>{tr('species.reproduction')}</dt>
              <dd>{d.reproduction[lang]}</dd>
            </div>
            <div>
              <dt>{tr('species.development')}</dt>
              <dd>{d.development[lang]}</dd>
            </div>
          </dl>

          <div class="flags">
            <span>
              <span class="diff" aria-hidden="true">
                {[1, 2, 3].map((k) => <i class:list={{ on: k <= d.difficulty }} />)}
              </span>
              {tr('species.difficulty').toLowerCase()}: <b>{tr(`species.difficulty.${d.difficulty}` as UiKey)}</b>
            </span>
            <span class:list={['yn', { yes: d.climbs }]}>
              {t.climbs}: <b>{tr(d.climbs ? 'species.yes' : 'species.no')}</b>
            </span>
            <span class:list={['yn', { yes: d.flies }]}>
              {t.flies}: <b>{tr(d.flies ? 'species.yes' : 'species.no')}</b>
            </span>
          </div>

          {
            Note && (
              <section class="own" data-glossary>
                <h2 class="lbl">{t.noteH}</h2>
                <Note />
              </section>
            )
          }

          {
            price && (
              <section class="buy">
                <div class="buy-h">
                  <span class="lbl">{t.buyLbl}</span>
                  <span class={`status st-${price.data.status}`}>{tr(`status.${price.data.status}`)}</span>
                </div>
                {price.data.note && <p class="pnote">{price.data.note[lang]}</p>}
                <PackPicker item={price} lang={lang} />
              </section>
            )
          }

          <div class="links">
            <a class="btn ghost small" href={`${routes.compare[lang]}?a=${entry.id}`}>
              {t.compare} <span class="arr">→</span>
            </a>
            {price && (
              <a class="link" href={routes.pricelist[lang]}>
                {tr('nav.pricelist')}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </article>

  {
    hasMore && (
      <section class="scene more" aria-labelledby="more-h">
        <div class="wrap">
          <div class="scene-head">
            <div class="rv">
              <div class="num">{t.moreNum}</div>
              <h2 class="h-display" id="more-h">{t.moreH} <em>{t.moreHem}</em></h2>
            </div>
          </div>
          <div class="more-grid">
            {d.sexing && (
              <article class="mcard sex rv" data-glossary>
                <h3>{t.sexH}</h3>
                <div class="sexpics">
                  {(['male', 'female'] as const).map((k) => {
                    const g = sexPhotos[k];
                    return (
                      <figure>
                        {g ? <img src={g.data.src} alt={`${d.latin} – ${t[k]}`} loading="lazy" /> : <div class="sexslot">{t.sexSlot}</div>}
                        <figcaption>{k === 'male' ? '♂' : '♀'} {t[k]}</figcaption>
                      </figure>
                    );
                  })}
                </div>
                <h4>{t.adults}</h4>
                <p>{d.sexing.adults[lang]}</p>
                {d.sexing.nymphs && (
                  <>
                    <h4>{t.nymphs}</h4>
                    <p>{d.sexing.nymphs[lang]}</p>
                  </>
                )}
              </article>
            )}
            <div class="mcol">
              {d.stages && (
                <article class="mcard rv" style="--d:.1s" data-glossary>
                  <h3>{t.stagesH}</h3>
                  <p>{d.stages[lang]}</p>
                </article>
              )}
              {d.problems.length > 0 && (
                <article class="mcard rv" style="--d:.15s" data-glossary>
                  <h3>{t.problemsH}</h3>
                  <ul class="probs">
                    {d.problems.map((p) => <li>{p[lang]}</li>)}
                  </ul>
                </article>
              )}
            </div>
            {d.remark && (
              <article class="mcard remark rv">
                <h3>{t.remarkH}</h3>
                <p>{d.remark[lang]}</p>
              </article>
            )}
            {tx && (
              <article class="mcard tax rv">
                <h3>{t.taxH}</h3>
                <dl>
                  <div><dt>{t.order}</dt><dd>Blattodea</dd></div>
                  <div><dt>{t.family}</dt><dd>{d.family}</dd></div>
                  {tx.subfamily && <div><dt>{t.subfamily}</dt><dd>{tx.subfamily}</dd></div>}
                  {tx.tribe && <div><dt>{t.tribe}</dt><dd>{tx.tribe}</dd></div>}
                  {tx.synonyms.length > 0 && <div><dt>{t.synonyms}</dt><dd class="it">{tx.synonyms.join('; ')}</dd></div>}
                  {tx.tradeNames.length > 0 && <div><dt>{t.trade}</dt><dd>{tx.tradeNames.join(', ')}</dd></div>}
                </dl>
                {tx.csf && <a class="link" href={tx.csf} target="_blank" rel="noopener">{t.csf} →</a>}
              </article>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="scene breed">
    <div class="glowspot" style="width:620px;height:620px;left:-220px;top:20px;background:radial-gradient(circle,rgba(125,154,87,.15),transparent 65%)"></div>
    <div class="wrap">
      <div class="scene-head">
        <div class="rv">
          <div class="num">{t.breedNum}</div>
          <h2 class="h-display">{t.breedH} <em>{t.breedHem}</em></h2>
        </div>
        <p class="rv" style="--d:.15s">{t.breedP}</p>
      </div>

      {
        breeding.length > 0 ? (
          <ul class="tiles">
            {breeding.map((g, i) => {
              const gd = g.data;
              const title = gd.title[lang];
              const cap = gd.caption?.[lang];
              const has = gd.kind === 'photo' ? !!gd.src : !!(gd.src || gd.youtube);
              return (
                <li class:list={['gt', 'rv', `k-${gd.kind}`, { slot: !has }]} style={`--d:${(i % 3) * 0.1}s`}>
                  <div class="media">
                    {gd.kind === 'photo' && gd.src ? (
                      <button type="button" class="zoom" data-src={gd.src} data-cap={cap ?? title} aria-label={`${t.zoom}: ${title}`}>
                        <img src={gd.src} alt={title} loading="lazy" />
                      </button>
                    ) : gd.kind === 'video' && gd.src ? (
                      <video controls preload="metadata" poster={gd.poster} src={gd.src}>
                        <track kind="captions" />
                      </video>
                    ) : gd.kind === 'video' && gd.youtube ? (
                      <iframe
                        src={ytEmbed(gd.youtube)}
                        title={title}
                        loading="lazy"
                        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"
                      />
                    ) : (
                      <div class="nophoto">
                        <span class="ic" aria-hidden="true">
                          {gd.kind === 'video' ? '▷' : '◎'}
                        </span>
                        <b>{gd.kind === 'video' ? t.slotVideo : t.slotPhoto}</b>
                        {title}
                      </div>
                    )}
                    <span class="kind">{gd.kind === 'video' ? t.video : t.photo}</span>
                  </div>
                  <div class="gt-b" data-glossary>
                    <h3>{title}</h3>
                    {cap && <p>{cap}</p>}
                    <div class="meta">
                      <time datetime={gd.date.toISOString().slice(0, 10)}>{formatDate(gd.date, lang)}</time>
                      {gd.sample && <span class="smp">{tr('sample.badge')}</span>}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty rv">{t.breedEmpty}</p>
        )
      }

      <div class="after rv">
        <a class="btn quiet" href={routes.gallery[lang]}>
          {t.fullGallery} <span class="arr">→</span>
        </a>
        <a class="btn ghost" href={`${routes.compare[lang]}?a=${entry.id}`}>
          {t.compare} <span class="arr">→</span>
        </a>
        {
          next && next.id !== entry.id && (
            <a class="nextlink" href={`${routes.species[lang]}${next.id}/`}>
              <span class="lbl">{t.next}</span>
              <span class="latin">{next.data.latin}</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-label={tr('species.gallery')}>
    <form method="dialog">
      <button class="x" aria-label={t.close}>×</button>
    </form>
    <img alt="" />
    <p class="cap"></p>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector<HTMLElement>('.cap');
  document.querySelectorAll<HTMLButtonElement>('button.zoom').forEach((b) => {
    b.addEventListener('click', () => {
      if (!dlg || !img || !cap) return;
      const src = b.dataset.src ?? '';
      if (typeof dlg.showModal !== 'function') {
        window.open(src, '_blank', 'noopener');
        return;
      }
      img.src = src;
      img.alt = b.querySelector('img')?.alt ?? '';
      cap.textContent = b.dataset.cap ?? '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

<style>
  .more {
    padding-top: clamp(50px, 7vw, 90px);
    padding-bottom: 0;
  }
  .more-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  .mcol {
    display: grid;
    gap: 14px;
  }
  .mcard {
    border: 1px solid var(--line);
    background: linear-gradient(160deg, var(--bg3), var(--bg2));
    padding: clamp(22px, 2.6vw, 34px);
  }
  .mcard h3 {
    font-size: clamp(24px, 2.2vw, 30px);
    font-style: italic;
    font-weight: 300;
    margin-bottom: 14px;
  }
  .mcard h4 {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 18px 0 6px;
  }
  .mcard p {
    margin: 0;
    color: #d3cfbf;
    font-size: 15px;
    line-height: 1.6;
  }
  .sexpics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .sexpics figure {
    margin: 0;
  }
  .sexpics img,
  .sexslot {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: grid;
    place-items: center;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    border: 1px dashed var(--line2);
    text-align: center;
    padding: 8px;
  }
  .sexpics figcaption {
    margin-top: 6px;
    font-family: var(--serif);
    font-style: italic;
    color: var(--amber2);
  }
  .probs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .probs li {
    position: relative;
    padding-left: 22px;
    color: #d3cfbf;
    font-size: 15px;
    line-height: 1.55;
  }
  .probs li::before {
    content: '!';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--serif);
    font-style: italic;
    color: var(--amber);
  }
  .remark {
    border-color: rgba(232, 165, 71, 0.4);
  }
  .tax dl {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .tax dl div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 10px;
    font-size: 14px;
  }
  .tax dt {
    color: var(--muted);
  }
  .tax dd {
    margin: 0;
    color: var(--text);
  }
  .tax .it {
    font-style: italic;
  }
  .tax .link {
    display: inline-block;
    margin-top: 14px;
  }
  @media (max-width: 860px) {
    .more-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sp {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding: clamp(110px, 13vw, 150px) 0 0;
  }
  .crumbs {
    margin: 0 0 18px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }
  .crumbs a:hover {
    color: var(--amber2);
  }

  /* karta pełnostronicowa */
  .full {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    overflow: clip;
  }
  .photo {
    position: relative;
    min-height: 420px;
    border-right: 1px solid var(--line);
  }
  .stick {
    position: sticky;
    top: 80px;
  }
  .photo :global(.commons .frame) {
    aspect-ratio: 4 / 5;
    border-radius: 0;
  }
  .photo :global(.commons .frame)::after,
  .mainph::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 90% at 45% 45%, transparent 35%, rgba(11, 18, 13, 0.75) 100%),
      linear-gradient(90deg, transparent 60%, rgba(11, 18, 13, 0.55));
  }
  .photo :global(.commons .credit) {
    position: absolute;
    left: 18px;
    bottom: 14px;
    right: 18px;
    z-index: 2;
    background: rgba(11, 18, 13, 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    padding: 6px 10px;
    width: fit-content;
    max-width: calc(100% - 36px);
  }
  .mainph {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--bg2);
    cursor: zoom-in;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .mainph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) brightness(0.86);
    transition: transform 1.4s var(--ease);
  }
  .mainph:hover img {
    transform: scale(1.04);
  }
  .owncap {
    padding: 10px 18px 16px;
    margin: 0;
  }
  .idx {
    position: absolute;
    top: 18px;
    left: 22px;
    z-index: 2;
    font-family: var(--serif);
    font-size: clamp(64px, 7vw, 110px);
    line-height: 1;
    font-weight: 200;
    color: rgba(255, 210, 138, 0.85);
    text-shadow: 0 0 40px rgba(232, 165, 71, 0.5);
    pointer-events: none;
  }
  .thumbs {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 12px;
  }
  .thumbs button {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
