---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { routes, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { formatPrice, getPriceForProfile, getSpeciesNote } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'species'>;
}
const { lang, entry } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const d = entry.data;

const price = await getPriceForProfile(entry.id);
const note = await getSpeciesNote(entry.id, lang);
const Note = note ? (await render(note)).Content : null;

const rows: { label: UiKey; value: string }[] = [
  { label: 'species.family', value: d.family },
  { label: 'species.origin', value: d.origin[lang] },
  { label: 'species.size', value: d.size[lang] },
  { label: 'species.temperature', value: d.temperature },
  { label: 'species.humidity', value: d.humidity[lang] },
  { label: 'species.substrate', value: d.substrate[lang] },
  { label: 'species.food', value: d.food[lang] },
  { label: 'species.reproduction', value: d.reproduction[lang] },
  { label: 'species.development', value: d.development[lang] },
  { label: 'species.climbs', value: tr(d.climbs ? 'species.yes' : 'species.no') },
  { label: 'species.flies', value: tr(d.flies ? 'species.yes' : 'species.no') },
];
const difficultyLabel = tr(`species.difficulty.${d.difficulty}` as UiKey);
const orderWord = lang === 'pl' ? 'Zamówienie' : 'Order';
const description = `${d.latin}${d.commonName ? ` (${d.commonName[lang]})` : ''} – ${tr('species.card').toLowerCase()}: ${d.temperature}, ${d.humidity[lang]}, ${d.food[lang]}.`;
---

<Base
  lang={lang}
  title={d.latin}
  description={description}
  alt={`${routes.species[other]}${entry.id}/`}
  active="species"
  image={d.gallery[0]?.src.endsWith('.svg') ? undefined : d.gallery[0]?.src}
>
  <article class="wrap">
    <p class="crumbs"><a href={routes.species[lang]}>← {tr('species.back')}</a></p>

    <header class="head">
      <span class="eyebrow">{d.family}</span>
      <h1>
        <span class="latin">{d.latin}</span>
        {d.author && <span class="author">{d.author}</span>}
      </h1>
      {d.commonName && <p class="common">{d.commonName[lang]}</p>}
      {d.sample && <p class="notice">{tr('sample.note')}</p>}
    </header>

    <div class="layout">
      <div class="main">
        {
          d.gallery.length > 0 && (
            <figure class="hero plate">
              <img src={d.gallery[0].src} alt={d.gallery[0].alt[lang]} width="800" height="600" />
              <figcaption>
                <span class="smallcaps">{tr('species.fig')} 1.</span> <span class="latin">{d.latin}</span>
                {d.gallery[0].caption && <> — {d.gallery[0].caption[lang]}</>}
              </figcaption>
            </figure>
          )
        }

        {
          Note && (
            <section class="notes prose">
              <h2>{tr('species.notes')}</h2>
              <Note />
            </section>
          )
        }

        {
          d.gallery.length > 1 && (
            <section class="gallery">
              <h2>{tr('species.gallery')}</h2>
              <ul>
                {d.gallery.slice(1).map((g, i) => (
                  <li>
                    <figure>
                      <a href={g.src} class="zoom" data-caption={g.caption?.[lang] ?? ''}>
                        <img src={g.src} alt={g.alt[lang]} loading="lazy" width="800" height="600" />
                      </a>
                      <figcaption>
                        <span class="smallcaps">
                          {tr('species.fig')} {i + 2}.
                        </span>{' '}
                        {g.caption?.[lang]}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="side">
        <section class="plate card">
          <h2>{tr('species.card')}</h2>
          <dl>
            {
              rows.map((r) => (
                <div>
                  <dt>{tr(r.label)}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))
            }
            <div>
              <dt>{tr('species.difficulty')}</dt>
              <dd>
                <span class="dots" aria-hidden="true">
                  {[1, 2, 3].map((n) => <span class:list={['dot', { on: n <= d.difficulty }]} />)}
                </span>
                {difficultyLabel}
              </dd>
            </div>
          </dl>
        </section>

        {
          price && (
            <section class="plate buy">
              <h2>{tr('species.inPricelist')}</h2>
              <p>
                <span class={`badge ${price.data.status}`}>{tr(`status.${price.data.status}`)}</span>
              </p>
              <dl class="stages">
                {price.data.prices.map((p) => (
                  <div>
                    <dt>{tr(`stage.${p.stage}`)}</dt>
                    <dd>
                      {formatPrice(p.price, lang)}
                      {p.per > 1 && (
                        <span class="per">
                          {' '}
                          / {p.per} {tr('pricelist.pcs')}
                        </span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="actions">
                {price.data.status !== 'out' && (
                  <a class="button" href={`mailto:${site.contact.email}?subject=${encodeURIComponent(`${orderWord}: ${d.latin}`)}`}>
                    {tr('pricelist.order')}
                  </a>
                )}
                <a class="button ghost" href={routes.pricelist[lang]}>
                  {tr('nav.pricelist')}
                </a>
              </p>
            </section>
          )
        }
      </aside>
    </div>
  </article>

  <dialog class="lightbox" aria-label={tr('species.gallery')}>
    <form method="dialog"><button aria-label="Zamknij / Close">×</button></form>
    <img alt="" />
    <p class="cap"></p>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector<HTMLElement>('.cap');
  document.querySelectorAll<HTMLAnchorElement>('a.zoom').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!dlg || !img || !cap || typeof dlg.showModal !== 'function') return;
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

<style>
  .crumbs {
    padding-top: 1.5rem;
    margin: 0;
    font-size: 0.92rem;
  }
  .head {
    padding: 1.2rem 0 1.5rem;
    border-bottom: 1px solid var(--rule-strong);
    box-shadow: 0 3px 0 -2px var(--rule);
    margin-bottom: 2rem;
  }
  h1 {
    margin-bottom: 0.15em;
  }
  .author {
    font-family: var(--serif-text);
    font-size: 1rem;
    font-weight: normal;
    color: var(--ink-faint);
    margin-left: 0.6rem;
    white-space: nowrap;
  }
  .common {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .head .notice {
    margin: 1rem 0 0;
  }
  .layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(340px, 1fr);
      gap: 3rem;
      align-items: start;
    }
    .side {
      position: sticky;
      top: 90px;
    }
  }
  .hero {
    margin: 6px 6px 2rem;
    padding: 0.75rem;
  }
  .hero img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--ink-soft);
    padding-top: 0.6rem;
  }
  .notes {
    margin-bottom: 2rem;
  }
  .notes h2,
  .gallery h2,
  .side h2 {
    font-size: 1.6rem;
  }
  .gallery ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .gallery figure {
    margin: 0;
    background: var(--card);
    border: 1px solid var(--rule);
    padding: 0.5rem;
  }
  .gallery img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
  .card dl,
  .stages {
    margin: 0;
  }
  .card dl div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px dotted var(--rule-strong);
  }
  .card dl div:last-child {
    border-bottom: 0;
  }
  .card dt {
    font-variant: small-caps;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 420px) {
    .card dl div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
  .dots {
    display: inline-flex;
    gap: 3px;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--moss);
  }
  .dot.on {
    background: var(--moss);
  }
  .buy {
    margin-top: 1.75rem;
  }
  .stages div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .stages dt {
    color: var(--ink-soft);
  }
  .stages dd {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .per {
    color: var(--ink-faint);
    font-size: 0.88rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }

  .lightbox {
    border: 1px solid var(--rule-strong);
    background: var(--card);
    padding: 1rem;
    max-width: min(960px, 94vw);
  }
  .lightbox::backdrop {
    background: rgba(30, 24, 16, 0.75);
  }
  .lightbox img {
    max-height: 80vh;
    width: auto;
    margin: 0 auto;
  }
  .lightbox form {
    text-align: right;
  }
  .lightbox button {
    font-size: 1.6rem;
    line-height: 1;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
  }
  .cap {
    text-align: center;
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
  }
</style>
