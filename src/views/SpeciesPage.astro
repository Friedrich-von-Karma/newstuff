---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CommonsPhoto from '../components/CommonsPhoto.astro';
import PackPicker from '../components/PackPicker.astro';
import { photos } from '../data/photos';
import { routes, useTranslations, type Lang, type UiKey } from '../i18n/ui';
import { getPriceForProfile, getSpeciesNote } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'species'>;
}
const { lang, entry } = Astro.props;
const tr = useTranslations(lang);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
const pl = lang === 'pl';
const d = entry.data;

const price = await getPriceForProfile(entry.id);
const note = await getSpeciesNote(entry.id, lang);
const Note = note ? (await render(note)).Content : null;

const rows: { label: UiKey; value: string }[] = [
  { label: 'species.origin', value: d.origin[lang] },
  { label: 'species.size', value: d.size[lang] },
  { label: 'species.temperature', value: d.temperature },
  { label: 'species.humidity', value: d.humidity[lang] },
  { label: 'species.substrate', value: d.substrate[lang] },
  { label: 'species.food', value: d.food[lang] },
  { label: 'species.reproduction', value: d.reproduction[lang] },
  { label: 'species.development', value: d.development[lang] },
];
const difficultyLabel = tr(`species.difficulty.${d.difficulty}` as UiKey);
const description = `${d.latin}${d.commonName ? ` (${d.commonName[lang]})` : ''} – ${tr('species.card').toLowerCase()}: ${d.temperature}, ${d.humidity[lang]}, ${d.food[lang]}.`;
const hasPhoto = !!photos[entry.id];
---

<Base lang={lang} title={d.latin} description={description} alt={`${routes.species[other]}${entry.id}/`} active="species" image={d.gallery[0]?.src}>
  <article class="wrap">
    <p class="crumbs type"><a href={routes.species[lang]}>← {tr('species.back')}</a></p>

    <header class="titlepage head">
      <span class="kicker">{d.family}</span>
      <h1>
        <span class="latin">{d.latin}</span>
      </h1>
      <p class="auth type">{d.author}</p>
      {d.commonName && <p class="lead">{d.commonName[lang]}</p>}
    </header>

    {d.sample && <p class="notice">{tr('sample.note')}</p>}

    <div class="layout">
      <div class="main">
        {
          (hasPhoto || d.gallery.length > 0) && (
            <div class="plate" data-reveal="zoom">
              <span class="corner tl" />
              <span class="corner tr" />
              <span class="corner bl" />
              <span class="corner br" />
              {d.gallery.length > 0 ? (
                <figure class="own">
                  <img src={d.gallery[0].src} alt={d.gallery[0].alt[lang]} />
                  {d.gallery[0].caption && <figcaption class="type">{d.gallery[0].caption[lang]}</figcaption>}
                </figure>
              ) : (
                <CommonsPhoto id={entry.id} lang={lang} alt={d.latin} width={1280} eager />
              )}
              <p class="plate-cap">
                <span class="caps">{tr('species.fig')} 1.</span> <i>{d.latin}</i> {d.author}
              </p>
            </div>
          )
        }

        {
          Note && (
            <section class="notes prose" data-reveal>
              <h2>{tr('species.notes')}</h2>
              <div class="dropcap">
                <Note />
              </div>
            </section>
          )
        }

        {
          d.gallery.length > 1 && (
            <section class="gallery" data-reveal>
              <h2>{tr('species.gallery')}</h2>
              <ul>
                {d.gallery.slice(1).map((g, i) => (
                  <li>
                    <a href={g.src} class="zoom" data-caption={g.caption?.[lang] ?? ''}>
                      <img src={g.src} alt={g.alt[lang]} loading="lazy" />
                    </a>
                    <p class="type">
                      {tr('species.fig')} {i + 2}. {g.caption?.[lang]}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="side">
        <section class="card" data-reveal="right">
          <header class="card-head">
            <span class="type">{pl ? 'Karta hodowlana' : 'Care card'}</span>
            <h2>{tr('species.card')}</h2>
          </header>
          <dl>
            {
              rows.map((r) => (
                <div>
                  <dt>{tr(r.label)}</dt>
                  <dd>{r.value}</dd>
                </div>
              ))
            }
            <div>
              <dt>{tr('species.climbs')}</dt>
              <dd class:list={['yn', d.climbs ? 'yes' : 'no']}>{tr(d.climbs ? 'species.yes' : 'species.no')}</dd>
            </div>
            <div>
              <dt>{tr('species.flies')}</dt>
              <dd class:list={['yn', d.flies ? 'yes' : 'no']}>{tr(d.flies ? 'species.yes' : 'species.no')}</dd>
            </div>
            <div>
              <dt>{tr('species.difficulty')}</dt>
              <dd>
                <span class="dots" aria-hidden="true">
                  {[1, 2, 3].map((n) => <span class:list={['dot', { on: n <= d.difficulty }]} />)}
                </span>
                {difficultyLabel}
              </dd>
            </div>
          </dl>
        </section>

        {
          price && (
            <section class="buy" data-reveal="right" style="--d:150">
              <h2>{tr('species.inPricelist')}</h2>
              <span class={`stamp ${price.data.status} big`}>{tr(`status.${price.data.status}`)}</span>
              <PackPicker item={price} lang={lang} />
            </section>
          )
        }
      </aside>
    </div>
  </article>

  <dialog class="lightbox" aria-label={tr('species.gallery')}>
    <form method="dialog"><button aria-label="Zamknij / Close">×</button></form>
    <img alt="" />
    <p class="cap"></p>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector<HTMLElement>('.cap');
  document.querySelectorAll<HTMLAnchorElement>('a.zoom').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!dlg || !img || !cap || typeof dlg.showModal !== 'function') return;
      e.preventDefault();
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      dlg.showModal();
    });
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

<style>
  .crumbs {
    padding-top: 1.5rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .head {
    margin-bottom: 2rem;
  }
  .head h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
  }
  .auth {
    color: var(--ink-faint);
    font-size: 0.9rem;
    margin: 0 0 0.3rem;
  }
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.45fr) minmax(340px, 1fr);
      align-items: start;
    }
    .side {
      position: sticky;
      top: 100px;
    }
  }

  /* tablica z ozdobną ramą */
  .plate {
    position: relative;
    background: var(--label);
    padding: 1.4rem;
    border: 1px solid var(--brass-dark);
    outline: 1px solid var(--rule);
    outline-offset: 7px;
    box-shadow: 0 30px 40px -30px rgba(40, 25, 10, 0.7);
    margin: 8px 8px 3rem;
  }
  .corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 2px solid var(--brass-dark);
  }
  .tl {
    top: 6px;
    left: 6px;
    border-right: 0;
    border-bottom: 0;
  }
  .tr {
    top: 6px;
    right: 6px;
    border-left: 0;
    border-bottom: 0;
  }
  .bl {
    bottom: 6px;
    left: 6px;
    border-right: 0;
    border-top: 0;
  }
  .br {
    bottom: 6px;
    right: 6px;
    border-left: 0;
    border-top: 0;
  }
  .plate :global(.frame) {
    aspect-ratio: 3 / 2;
  }
  .own {
    margin: 0;
  }
  .own img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .plate-cap {
    text-align: center;
    margin: 0.8rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .notes h2,
  .gallery h2 {
    font-size: 2rem;
  }
  .gallery ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .gallery img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
    border: 6px solid #fff;
    box-shadow: 0 8px 14px -8px rgba(0, 0, 0, 0.5);
  }
  .gallery p {
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  /* karta hodowlana */
  .card {
    position: relative;
    background-color: #fbf8ef;
    background-image: repeating-linear-gradient(180deg, transparent 0 31px, rgba(60, 90, 120, 0.12) 31px 32px);
    border: 1px solid #d6c9a6;
    border-top: 4px solid var(--bottle-600);
    padding: 1.4rem 1.5rem 1.2rem;
    box-shadow: 0 24px 34px -24px rgba(40, 25, 10, 0.6);
  }
  .card-head .type {
    font-size: 0.72rem;
    color: var(--stamp-red);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .card-head h2 {
    font-size: 1.9rem;
    margin: 0.2rem 0 0.8rem;
  }
  dl {
    margin: 0;
  }
  .card dl > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.8rem;
    padding: 0.45rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .card dt {
    font-family: var(--f-caps);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--wood-600);
    font-size: 0.98rem;
    line-height: 1.3;
  }
  .card dd {
    margin: 0;
    font-size: 0.97rem;
  }
  .yn {
    font-family: var(--f-type);
  }
  .yn.yes::before {
    content: '✓ ';
    color: var(--stamp-green);
  }
  .yn.no::before {
    content: '✗ ';
    color: var(--stamp-red);
  }
  .dots {
    display: inline-flex;
    gap: 4px;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--brass-dark);
  }
  .dot.on {
    background: radial-gradient(circle at 35% 30%, #f5e2b4, #b8945a 70%);
  }
  @media (max-width: 420px) {
    .card dl > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .buy {
    position: relative;
    margin-top: 2rem;
    padding: 1.4rem 1.5rem;
    background: var(--label);
    border: 1px dashed var(--brass-dark);
  }
  .buy h2 {
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
  }
  .buy .big {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    font-size: 0.95rem;
  }
  .lightbox {
    border: 8px solid var(--label);
    background: var(--label);
    padding: 0.5rem;
    max-width: min(960px, 94vw);
  }
  .lightbox::backdrop {
    background: rgba(20, 14, 8, 0.82);
  }
  .lightbox img {
    max-height: 80vh;
    width: auto;
    margin: 0 auto;
  }
  .lightbox form {
    text-align: right;
  }
  .lightbox button {
    font-size: 1.8rem;
    line-height: 1;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .cap {
    text-align: center;
    margin: 0.5rem 0 0;
    font-family: var(--f-type);
    font-size: 0.85rem;
  }
</style>
