---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { glossary } from '../data/glossary';
import { routes } from '../i18n/ui';
import { site } from '../data/site';
import { useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Adres tej samej strony w drugim języku. */
  alt: string;
  active?: RouteKey;
  image?: string;
  /** nie pokazuj w wyszukiwarkach (np. strona podziękowania) */
  noindex?: boolean;
}

const { lang, title, description, alt, active, image, noindex = false } = Astro.props;
const tr = useTranslations(lang);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} – ${tr('site.tagline')}`;
const desc = description ?? tr('home.lead');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(alt, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
const other: Lang = lang === 'pl' ? 'en' : 'pl';
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={altUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b120d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_GB'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="torch" aria-hidden="true"></div>
    <Header lang={lang} alt={alt} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CartDrawer lang={lang} />
    <script
      type="application/json"
      id="glossary-data"
      set:html={JSON.stringify({
        href: routes.glossary[lang],
        more: lang === 'pl' ? 'Słowniczek →' : 'Glossary →',
        terms: glossary.map((g) => ({ id: g.id, t: g.term[lang], d: g.def[lang], m: g.match[lang] })),
      })}
    />
    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Światło lampy podąża za kursorem.
      if (!reduce && matchMedia('(hover: hover)').matches) {
        let raf = 0;
        window.addEventListener('pointermove', (e) => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            document.documentElement.style.setProperty('--mx', `${e.clientX}px`);
            document.documentElement.style.setProperty('--my', `${e.clientY}px`);
          });
        });
      }

      // Elementy .rv (i starsze [data-reveal]) pojawiają się przy przewijaniu.
      const els = document.querySelectorAll<HTMLElement>('.rv, [data-reveal]');
      if ('IntersectionObserver' in window && !reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }

      // Słowniczek: pierwsze wystąpienie terminu w tekstach [data-glossary] dostaje dymek z definicją.
      const raw = document.getElementById('glossary-data')?.textContent;
      const zones = document.querySelectorAll<HTMLElement>('[data-glossary]');
      if (raw && zones.length) {
        const data = JSON.parse(raw) as { href: string; more: string; terms: { id: string; t: string; d: string; m: string }[] };
        const used = new Set<string>();
        const tip = document.createElement('div');
        tip.className = 'term-tip';
        tip.setAttribute('role', 'tooltip');
        tip.id = 'term-tip';
        document.body.appendChild(tip);
        let hideT = 0;
        const show = (el: HTMLElement) => {
          const term = data.terms.find((x) => x.id === el.dataset.term);
          if (!term) return;
          clearTimeout(hideT);
          tip.innerHTML = '';
          const b = document.createElement('b');
          b.textContent = term.t;
          const p = document.createElement('div');
          p.textContent = term.d;
          const a = document.createElement('a');
          a.href = `${data.href}#${term.id}`;
          a.textContent = data.more;
          tip.append(b, p, a);
          const r = el.getBoundingClientRect();
          const w = Math.min(300, window.innerWidth - 24);
          tip.style.width = `${w}px`;
          tip.style.left = `${Math.max(12, Math.min(window.scrollX + r.left, window.scrollX + window.innerWidth - w - 12))}px`;
          tip.style.top = `${window.scrollY + r.bottom + 8}px`;
          tip.classList.add('on');
          el.setAttribute('aria-describedby', 'term-tip');
        };
        const hide = () => {
          hideT = window.setTimeout(() => tip.classList.remove('on'), 180);
        };
        tip.addEventListener('pointerenter', () => clearTimeout(hideT));
        tip.addEventListener('pointerleave', hide);
        const skip = 'A,BUTTON,LABEL,INPUT,SELECT,TEXTAREA,H1,H2,H3,H4,CODE,SCRIPT,STYLE';
        zones.forEach((zone) => {
          const walker = document.createTreeWalker(zone, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) => ((n.parentElement?.closest(skip) || n.parentElement?.closest('.term')) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
          });
          const nodes: Text[] = [];
          while (walker.nextNode()) nodes.push(walker.currentNode as Text);
          for (const node of nodes) {
            for (const term of data.terms) {
              if (used.has(term.id)) continue;
              const re = new RegExp(`(^|[^\\p{L}])(${term.m})(?![\\p{L}])`, 'iu');
              const m = node.data.match(re);
              if (!m || m.index === undefined) continue;
              const start = m.index + m[1].length;
              const word = node.splitText(start);
              word.splitText(m[2].length);
              const span = document.createElement('span');
              span.className = 'term';
              span.tabIndex = 0;
              span.dataset.term = term.id;
              word.replaceWith(span);
              span.appendChild(word);
              used.add(term.id);
              span.addEventListener('pointerenter', () => show(span));
              span.addEventListener('pointerleave', hide);
              span.addEventListener('focus', () => show(span));
              span.addEventListener('blur', hide);
              span.addEventListener('click', () => (tip.classList.contains('on') ? hide() : show(span)));
              break;
            }
          }
        });
      }
    </script>
  </body>
</html>
