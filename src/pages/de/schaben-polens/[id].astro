---
import type { GetStaticPaths } from 'astro';
import WildPage from '../../../views/WildPage.astro';
import { taxa } from '../../../data/key';

export const getStaticPaths = (() => taxa.map((t) => ({ params: { id: t.id } }))) satisfies GetStaticPaths;
const { id } = Astro.params;
---

<WildPage lang="de" id={id!} />
